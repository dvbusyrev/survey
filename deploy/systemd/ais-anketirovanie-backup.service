[Unit]
Description=AIS Anketirovanie encrypted PostgreSQL backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ais-anketirovanie
Group=ais-anketirovanie
EnvironmentFile=/etc/ais-anketirovanie/backup.env
Environment=GNUPGHOME=/var/lib/ais-anketirovanie/gnupg
WorkingDirectory=/opt/ais-anketirovanie
ExecStart=/usr/bin/env bash /opt/ais-anketirovanie/scripts/backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/ais-anketirovanie /var/lib/ais-anketirovanie/gnupg
