# Copy to /etc/ais-anketirovanie/backup.env and set mode 0600.
# Prefer a PostgreSQL service definition and PGPASSFILE instead of a password in this file.
SURVEY_BACKUP_CONNECTION=service=ais_survey_backup
PGSERVICEFILE=/etc/ais-anketirovanie/postgresql_service.conf
PGPASSFILE=/etc/ais-anketirovanie/postgresql.pass
SURVEY_BACKUP_DIRECTORY=/var/backups/ais-anketirovanie
SURVEY_BACKUP_ENCRYPTION_PASSPHRASE_FILE=/etc/ais-anketirovanie/backup-passphrase
SURVEY_BACKUP_RETENTION_DAYS=30

# The restore verification database is destroyed after every successful or failed check.
SURVEY_RESTORE_VERIFY_CONNECTION=service=ais_survey_restore_verify
SURVEY_RESTORE_VERIFY_ADMIN_CONNECTION=service=ais_survey_restore_verify_admin
SURVEY_RESTORE_VERIFY_DATABASE=survey_restore_verify
