@using System.Text.Json
@model MainProject.Web.ViewModels.AnswerListPageViewModel
@{
    ViewData["Title"] = "Журнал ответов";
    ViewData["SurveySection"] = "answers";
    var pageModel = Model ?? new MainProject.Web.ViewModels.AnswerListPageViewModel();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/survey-admin-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/answers.css" asp-append-version="true" />
}

<div class="app-page answers-page"
     id="default_content"
     data-page="answers-list"
     data-total-count="@pageModel.TotalCount"
     data-visible-count="@pageModel.Answers.Count"
     data-table-scroll-target="#answers-table-top"
     data-filter-item-label="ответов"
     data-filter-date-summary="у которых дата ответа попадает"
     data-filter-hide-count-summary="true">
    @await Html.PartialAsync("~/Views/Survey/Partials/_SurveySubnav.cshtml")
    @await Html.PartialAsync(
        "~/Views/Shared/_PageIntro.cshtml",
        new MainProject.Web.ViewModels.PageIntroModel
        {
            // Title = "Ответы на анкеты",
            Description = "На этой странице вы можете посмотреть ответы организаций на анкеты."
        })

    <div class="app-page__toolbar survey-list-toolbar answers-page__filters">
        @await Html.PartialAsync("~/Views/Survey/Partials/_SurveyDateFilter.cshtml")
        @await Html.PartialAsync("~/Views/Survey/Partials/_SurveyOrganizationFilter.cshtml")
        @await Html.PartialAsync("~/Views/Survey/Partials/_SurveyNameFilter.cshtml")
    </div>

    <table id="answers-table-top"
           data-role="main-table"
           data-disable-column-sort="true">
        <thead>
            <tr class="app-table__header-row">
                <th class="table-th--start table-sortable @(string.IsNullOrWhiteSpace(pageModel.GetHeaderSortDirection(MainProject.Web.ViewModels.AnswerListSortFields.Organization)) ? string.Empty : "is-sorted")"
                    data-sort-direction="@pageModel.GetHeaderSortDirection(MainProject.Web.ViewModels.AnswerListSortFields.Organization)"
                    aria-sort="@pageModel.GetAriaSort(MainProject.Web.ViewModels.AnswerListSortFields.Organization)">
                    <a class="logs-table__sort-link" href="@pageModel.BuildSortUrl(MainProject.Web.ViewModels.AnswerListSortFields.Organization)">Организация</a>
                </th>
                <th class="table-sortable @(string.IsNullOrWhiteSpace(pageModel.GetHeaderSortDirection(MainProject.Web.ViewModels.AnswerListSortFields.Survey)) ? string.Empty : "is-sorted")"
                    data-sort-direction="@pageModel.GetHeaderSortDirection(MainProject.Web.ViewModels.AnswerListSortFields.Survey)"
                    aria-sort="@pageModel.GetAriaSort(MainProject.Web.ViewModels.AnswerListSortFields.Survey)">
                    <a class="logs-table__sort-link" href="@pageModel.BuildSortUrl(MainProject.Web.ViewModels.AnswerListSortFields.Survey)">Анкета</a>
                </th>
                <th class="table-col--date table-sortable @(string.IsNullOrWhiteSpace(pageModel.GetHeaderSortDirection(MainProject.Web.ViewModels.AnswerListSortFields.Date)) ? string.Empty : "is-sorted")"
                    data-sort-direction="@pageModel.GetHeaderSortDirection(MainProject.Web.ViewModels.AnswerListSortFields.Date)"
                    aria-sort="@pageModel.GetAriaSort(MainProject.Web.ViewModels.AnswerListSortFields.Date)">
                    <a class="logs-table__sort-link" href="@pageModel.BuildSortUrl(MainProject.Web.ViewModels.AnswerListSortFields.Date)">Дата</a>
                </th>
                <th class="answers-page__signature-column text-center table-sortable @(string.IsNullOrWhiteSpace(pageModel.GetHeaderSortDirection(MainProject.Web.ViewModels.AnswerListSortFields.Signed)) ? string.Empty : "is-sorted")"
                    data-sort-direction="@pageModel.GetHeaderSortDirection(MainProject.Web.ViewModels.AnswerListSortFields.Signed)"
                    aria-sort="@pageModel.GetAriaSort(MainProject.Web.ViewModels.AnswerListSortFields.Signed)">
                    <a class="logs-table__sort-link" href="@pageModel.BuildSortUrl(MainProject.Web.ViewModels.AnswerListSortFields.Signed)">Подпись</a>
                </th>
                <th class="table-th--end table-col--actions text-center">Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (!pageModel.Answers.Any())
            {
                <tr>
                    <td colspan="5" class="table-empty-cell" aria-hidden="true"></td>
                </tr>
            }
            else
            {
                <tr id="none_result"
                    data-role="survey-filter-empty-row"
                    class="is-hidden">
                    <td colspan="5" class="table-empty-cell" aria-hidden="true"></td>
                </tr>

                foreach (var answer in pageModel.Answers)
                {
                    var completionDateIso = answer.CompletionDate?.ToString("yyyy-MM-dd") ?? string.Empty;
                    var organizationNamesJson = JsonSerializer.Serialize(string.IsNullOrWhiteSpace(answer.OrganizationName)
                        ? Array.Empty<string>()
                        : new[] { answer.OrganizationName });

                    <tr class="active answers-page__row"
                        data-click-call="showAnswersModal"
                        data-click-args='[@answer.IdSurvey, @answer.IdOrganization]'
                        data-survey-id="@answer.IdSurvey"
                        data-survey-name="@(answer.SurveyName ?? string.Empty)"
                        data-survey-date-begin="@completionDateIso"
                        data-survey-date-end="@completionDateIso"
                        data-survey-organizations="@organizationNamesJson">
                        <td>@answer.OrganizationName</td>
                        <td>@answer.SurveyName</td>
                        <td class="table-col--date">@answer.CompletionDate?.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td class="answers-page__signature-column text-center">
                            @if (!answer.IsSigned)
                            {
                                <span class="answers-page__unsigned-icon">Нет подписи</span>
                            }
                            else
                            {
                                <span class="answers-page__signed-icon">Подписана</span>
                            }
                        </td>
                        <td class="answers-page__view-link answers-page__view-action action-icons table-col--actions text-center">
                            @if (answer.CanDelete)
                            {
                                <div class="action-icons__content">
                                    <button type="button"
                                            class="icon-container"
                                            data-answer-id="@answer.IdAnswer"
                                            data-survey-name="@(answer.SurveyName ?? string.Empty)"
                                            data-organization-name="@(answer.OrganizationName ?? string.Empty)"
                                            data-click-call="deleteAnswerFromTrigger"
                                            data-click-pass-element="true"
                                            aria-label="Удалить">
                                        <span aria-hidden="true"><i class="fas fa-trash"></i></span>
                                        <span class="icon-tooltip">Удалить</span>
                                    </button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @await Html.PartialAsync("~/Views/Shared/_AppPagination.cshtml", pageModel.Pagination)

    <script type="application/json" data-role="server-filter-bootstrap">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pageModel.FilterState))
    </script>

    @await Html.PartialAsync("~/Views/Shared/_AnswersModal.cshtml")
</div>

@section Scripts {
    @await Html.PartialAsync("~/Views/Shared/_AdminPageScripts.cshtml")
    @await Html.PartialAsync("~/Views/Shared/_AdminArchiveScripts.cshtml")
    <script src="~/js/features/survey/survey-filter-popover.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-filter-summary.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-date-filter.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-checkbox-filter.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-row-filtering.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-admin-date-filter.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/surveys-page.js" asp-append-version="true"></script>
    <script src="~/js/features/admin/admin-answers-list-page.js" asp-append-version="true"></script>
}
