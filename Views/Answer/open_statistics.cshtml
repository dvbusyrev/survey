@{
    ViewData["Title"] = "Статистика ответов";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/answers.css" asp-append-version="true" />
}

@section Head {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
}

<div class="app-page answers-page__statistics" id="default_content" data-page="answers-statistics">
                @await Html.PartialAsync(
                    "~/Views/Shared/_PageIntro.cshtml",
                    new MainProject.Web.ViewModels.PageIntroModel
                    {
                        Title = "Статистика ответов",
                        Description = "Аналитика средних оценок по годам, кварталам и организациям."
                    })

                <section class="app-section app-page__section">
                    <div class="answers-page__statistics-grid">
                        <div class="answers-page__statistics-card">
                            <h3 class="answers-page__statistics-title">По годам</h3>
                            <div class="answers-page__statistics-wrapper">
                                <canvas id="lineChart"></canvas>
                                <div class="answers-page__statistics-loading" id="lineLoading"></div>
                            </div>
                        </div>

                        <div class="answers-page__statistics-card">
                            <h3 class="answers-page__statistics-title">По кварталам</h3>
                            <div class="answers-page__statistics-wrapper">
                                <canvas id="barChart"></canvas>
                                <div class="answers-page__statistics-loading" id="barLoading"></div>
                            </div>
                        </div>

                        <div class="answers-page__statistics-card answers-page__statistics-card--wide">
                            <h3 class="answers-page__statistics-title">По организациям</h3>
                            <div class="answers-page__statistics-wrapper">
                                <canvas id="radarChart"></canvas>
                                <div class="answers-page__statistics-loading" id="radarLoading"></div>
                            </div>
                        </div>
                    </div>
                </section>
</div>

@section Scripts {
    <script src="~/js/features/answers/answer-statistics-page.js" asp-append-version="true"></script>
}
