@model MainProject.Web.ViewModels.UserSurveyAnswersContentViewModel

@{
    var pageModel = Model ?? new MainProject.Web.ViewModels.UserSurveyAnswersContentViewModel();
    var survey = pageModel.Survey ?? new MainProject.Application.DTO.SurveyAnswersSurveyViewModel();
    var answerGroups = pageModel.Answers ?? Array.Empty<MainProject.Application.DTO.SurveyAnswerResultViewModel>();
    var isSigned = !string.IsNullOrWhiteSpace(survey.Csp) || answerGroups.Any(answer => answer.IsSigned);
    var firstAnswerGroup = answerGroups.FirstOrDefault();
    var signatureInfo = answerGroups
        .Select(answer => answer.SignatureInfo)
        .FirstOrDefault(info => info?.IsSigned == true);
    var nameText = string.IsNullOrWhiteSpace(survey.Name) ? "Без названия" : survey.Name;
    var descriptionText = string.IsNullOrWhiteSpace(survey.Description) ? "Описание не указано" : survey.Description;
    var dateText = !string.IsNullOrWhiteSpace(firstAnswerGroup?.Date) ? firstAnswerGroup!.Date : "Дата не указана";
    var statusText = answerGroups.Any(group => group.Answers.Count > 0) ? "Пройдена" : "Не пройдена";
    var signatureStatusText = isSigned ? "Подписана" : "Нет подписи";
    var signedByText = !string.IsNullOrWhiteSpace(signatureInfo?.SignedBy) ? signatureInfo!.SignedBy : "Не удалось определить";
    var signatureCheckText = !string.IsNullOrWhiteSpace(signatureInfo?.Status) ? signatureInfo!.Status : "Проверка недоступна";
    var hasCertificateDates = !string.IsNullOrWhiteSpace(signatureInfo?.ValidFrom) || !string.IsNullOrWhiteSpace(signatureInfo?.ValidTo);
}

<div class="app-page app-page--narrow survey-editor-page"
     data-role="survey-answers-page"
     data-survey-id="@survey.Id"
     data-organization-id="@pageModel.OrganizationId"
     data-is-signed="@(isSigned ? "true" : "false")">
    <div class="answers-modal__info-block">
        <div class="answers-modal__field-label">Название</div>
        <div class="app-field answers-modal__info-text">@nameText</div>
    </div>

    <div class="answers-modal__info-block">
        <div class="answers-modal__field-label">Описание</div>
        <div class="app-field answers-modal__info-text">@descriptionText</div>
    </div>

    <div class="answers-modal__info-block">
        <div class="answers-modal__field-label">Статус</div>
        <div class="app-field answers-modal__info-text">@statusText</div>
    </div>

    <div class="answers-modal__info-block answers-modal__date-block">
        <div class="answers-modal__field-label">Дата</div>
        <div class="app-field answers-modal__date-text">@dateText</div>
    </div>

    <div class="answers-modal__info-block answers-modal__signature-block" data-role="signature-info">
        <div class="answers-modal__field-label">Подпись</div>
        <div class="app-field answers-modal__signature-text @(isSigned ? "signed" : "not-signed")" data-role="signature-status">
            @if (isSigned)
            {
                <div class="answers-modal__signature-line">
                    <span class="answers-modal__signature-line-label">Статус:</span>
                    <span class="answers-modal__signature-line-value">@signatureStatusText</span>
                </div>
                <div class="answers-modal__signature-line">
                    <span class="answers-modal__signature-line-label">Проверка:</span>
                    <span class="answers-modal__signature-line-value">@signatureCheckText</span>
                </div>
                <div class="answers-modal__signature-line">
                    <span class="answers-modal__signature-line-label">Подписант:</span>
                    <span class="answers-modal__signature-line-value">@signedByText</span>
                </div>
                @if (hasCertificateDates)
                {
                    <div class="answers-modal__signature-line">
                        <span class="answers-modal__signature-line-label">Сертификат:</span>
                        <span class="answers-modal__signature-line-value">Действует @(string.IsNullOrWhiteSpace(signatureInfo?.ValidFrom) ? "не указано" : signatureInfo!.ValidFrom) - @(string.IsNullOrWhiteSpace(signatureInfo?.ValidTo) ? "не указано" : signatureInfo!.ValidTo)</span>
                    </div>
                }
            }
            else
            {
                @signatureStatusText
            }
        </div>
    </div>

    @if (answerGroups.Count == 0)
    {
        <section class="app-section app-page__section" data-role="empty-message">
            Нет данных для отображения
        </section>
    }
    else
    {
        <div class="answers-table-container table-responsive answers-modal__table-wrap" data-role="answers-content">
            <table class="answers-table answers-modal__table" data-role="main-table" data-disable-column-sort="true">
                <thead>
                    <tr class="app-table__header-row">
                        <th class="table-th--start">Вопрос</th>
                        <th class="answers-modal__rating-column">Оценка</th>
                        <th class="table-th--end">Комментарий</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in answerGroups)
                    {
                        foreach (var answer in group.Answers)
                        {
                            <tr>
                                <td class="question-cell">@answer.QuestionText</td>
                                <td class="rating-cell">@answer.Rating</td>
                                <td class="comment-cell">@(!string.IsNullOrWhiteSpace(answer.Comment) ? answer.Comment : "Без комментария")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="button-container survey-user-answer-actions" data-role="body-actions">
        <div data-role="sign-actions">
            <button type="button"
                    class="app-button app-button--primary"
                    data-role="sign-button"
                    disabled="@(isSigned ? "disabled" : null)">
                @(isSigned ? "Подписано" : "Подписать")
            </button>
        </div>
        <button type="button" class="app-button app-button--secondary" data-role="download-btn">Скачать ответы</button>
    </div>
</div>
