@model MainProject.Web.ViewModels.UserSurveyTableViewModel

@{
    var surveys = Model?.Surveys ?? Array.Empty<MainProject.Domain.Entities.Survey>();
    var isArchive = Model?.IsArchive ?? false;
    var columnCount = isArchive ? 4 : 2;

    string FormatDate(DateTime? date)
    {
        return !date.HasValue || date.Value == default ? "Не указано" : date.Value.ToString("dd.MM.yyyy");
    }

    string FormatIsoDate(DateTime? date)
    {
        return !date.HasValue || date.Value == default ? string.Empty : date.Value.ToString("yyyy-MM-dd");
    }
}

<table class="surveys-table" data-role="main-table" data-disable-table-pagination="true">
    <thead>
        <tr class="app-table__header-row">
            <th class="table-th--start">Название</th>
            <th class="@(isArchive ? string.Empty : "table-th--end")">Период</th>
            @if (isArchive)
            {
                <th>Статус</th>
                <th class="table-th--end">Подпись</th>
            }
        </tr>
    </thead>
    <tbody data-role="survey-table-body">
        @if (surveys.Count == 0)
        {
            <tr data-role="user-survey-empty-row">
                <td colspan="@columnCount" class="table-empty-cell">Анкеты не найдены.</td>
            </tr>
        }
        else
        {
            @foreach (var survey in surveys)
            {
                DateTime? filterDate = isArchive
                    ? (survey.CompletionDate != default ? survey.CompletionDate : survey.DateEnd)
                    : survey.DateBegin;
                var filterMonth = !filterDate.HasValue || filterDate.Value == default ? string.Empty : filterDate.Value.ToString("MM");
                var filterYear = !filterDate.HasValue || filterDate.Value == default ? string.Empty : filterDate.Value.ToString("yyyy");
                var signatureText = isArchive
                    ? (!string.IsNullOrWhiteSpace(survey.Csp) ? "Подписана" : "Нет подписи")
                    : "Нет подписи";
                var statusText = isArchive
                    ? $"Заполнена: {FormatDate(survey.CompletionDate)}"
                    : "Не заполнена";
                var rowClass = isArchive ? "client-surveys-table__row client-surveys-table__row--viewable" : "client-surveys-table__row client-surveys-table__row--fillable";

                <tr class="@rowClass"
                    data-role="user-survey-row"
                    data-row-action="@(isArchive ? "view" : "fill")"
                    data-hover-label="@(isArchive ? "Смотреть" : "Заполнить")"
                    data-survey-id="@survey.IdSurvey"
                    data-survey-name="@(string.IsNullOrWhiteSpace(survey.NameSurvey) ? "Без названия" : survey.NameSurvey)"
                    data-survey-date-begin="@FormatIsoDate(survey.DateBegin)"
                    data-survey-date-end="@FormatIsoDate(survey.DateEnd)"
                    data-survey-organizations="[]"
                    data-filter-month="@filterMonth"
                    data-filter-year="@filterYear">
                    <td>@(string.IsNullOrWhiteSpace(survey.NameSurvey) ? "Без названия" : survey.NameSurvey)</td>
                    <td>@FormatDate(survey.DateBegin) - @FormatDate(survey.DateEnd)</td>
                    @if (isArchive)
                    {
                        <td>@statusText</td>
                        <td class="@(string.Equals(signatureText, "Подписана", StringComparison.Ordinal) ? "client-surveys-table__signature--signed" : "client-surveys-table__signature--unsigned")">
                            @signatureText
                        </td>
                    }
                </tr>
            }
            <tr data-role="survey-filter-empty-row" class="is-hidden">
                <td colspan="@columnCount" class="table-empty-cell">Результаты не найдены.</td>
            </tr>
        }
    </tbody>
</table>
