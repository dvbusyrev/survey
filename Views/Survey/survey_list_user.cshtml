@model MainProject.Web.ViewModels.UserSurveyListPageViewModel
@using System.Security.Claims
@using System.Text.Json
@using MainProject.Infrastructure.Security
@{
    ViewData["Title"] = "Активные анкеты";
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var nameOrganization = User.FindFirst("organization_name")?.Value ?? "";
    var nameUser = User.FindFirst(ClaimTypes.Name)?.Value ?? "";
    var displayName = !string.IsNullOrWhiteSpace(nameOrganization) && !string.IsNullOrWhiteSpace(nameUser)
        ? $"{nameOrganization}: {nameUser}"
        : (!string.IsNullOrWhiteSpace(nameUser) ? nameUser : AppRoles.GetDisplayName(userRole));
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var userId = int.TryParse(userIdClaim, out var parsedUserId) ? parsedUserId : 0;
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var userOrganizationId = Model.UserOrganizationId;
    var surveyListBootstrapJson = JsonSerializer.Serialize(new
    {
        userId,
        userRole,
        userOrganizationId,
        initialTab = "active",
        displayName,
        userName = nameUser,
        organizationName = nameOrganization
    });
    var pageContentModel = new MainProject.Web.ViewModels.UserSurveyPageContentViewModel
    {
        Surveys = Model.AccessibleSurveys,
        ActiveTab = "active",
        CurrentPage = Model.CurrentPage,
        TotalPages = Model.TotalPages,
        ActiveCount = Model.TotalCount,
        ArchivedCount = 0,
        SearchTerm = Model.SearchTerm
    };
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/survey-user.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/survey-admin-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin-utility-pages.css" asp-append-version="true" />
}

@if (!isAuthenticated)
{
    <div class="access-denied">
        <h2>Доступ запрещён</h2>
        <p>У вас нет прав для просмотра этой страницы.</p>
        <br/>
        <a href="/" class="btn">Вернуться на страницу авторизации</a>
    </div>
}
else
{
    <div class="app-page"
         id="default_content"
         data-page="user-surveys"
         data-filter-hide-count-summary="true">
        @await Html.PartialAsync("~/Views/Survey/Partials/_UserSurveyPageContent.cshtml", pageContentModel)
    </div>
    <div data-role="fill-modal-host"></div>
    <div data-role="answers-modal-host"></div>
    <script type="application/json" id="survey-user-list-bootstrap">@Html.Raw(surveyListBootstrapJson)</script>
}

@section Scripts {
    @if (isAuthenticated)
    {
        @await Html.PartialAsync("~/Views/Shared/_SurveyUserTemplates.cshtml")
        <script type="module" src="~/js/entries/survey-user-app.js" asp-append-version="true"></script>
    }
}
