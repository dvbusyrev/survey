@using MainProject.Application.DTO
@using MainProject.Infrastructure.Security
@using MainProject.Web.ViewModels

<template id="nav-template-admin">
  @await Html.PartialAsync("~/Views/Shared/_AppNavigation.cshtml", new AppNavigationViewModel { UserRole = AppRoles.Admin })
</template>

<template id="nav-template-user">
  @await Html.PartialAsync("~/Views/Shared/_AppNavigation.cshtml", new AppNavigationViewModel { UserRole = AppRoles.User })
</template>

<template id="header-template">
  @await Html.PartialAsync("~/Views/Shared/_AppHeader.cshtml", new UserChromeContext { UserRole = AppRoles.Admin })
</template>

<template id="footer-template">
  @await Html.PartialAsync("~/Views/Shared/_AppFooter.cshtml")
</template>
