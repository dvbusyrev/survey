@{
    var activeSection = (ViewData["UtilitySection"] as string ?? string.Empty).ToLowerInvariant();
    var logsActive = activeSection == "logs";
    var helpActive = activeSection == "help";
}

<div class="app-tabs app-page__subnav" role="tablist" aria-label="Служебные разделы">
    <a
        href="/logs"
        class="app-tab @(logsActive ? "active-tab" : "")"
        role="tab"
        aria-selected="@(logsActive ? "true" : "false")"
        data-tab-target="get_logs">
        Журнал событий
    </a>
    <a
        href="/help"
        class="app-tab @(helpActive ? "active-tab" : "")"
        role="tab"
        aria-selected="@(helpActive ? "true" : "false")"
        data-tab-target="help">
        Справка
    </a>
</div>
