<form id="organizationForm" class="organization-form">
    @Html.AntiForgeryToken()

    <div class="app-field-group">
        <label for="Name">Организация</label>
        <input type="text" class="app-field" id="Name" placeholder="Введите название организации" required data-required-message="Введите название организации.">
    </div>

    <div class="app-field-group">
        <label for="organization_email">Эл. почта организации</label>
        <input type="text" class="app-field" id="organization_email" placeholder="Введите эл. почту">
    </div>

    <div class="app-field-group">
        <label for="DateBegin">Дата начала</label>
        <input type="date" class="app-field" id="DateBegin" data-date-native="true" data-date-label="Дата начала" lang="ru-RU" required data-required-message="Укажите дату начала.">
    </div>

    <div class="button-container organization-form__actions">
        <button type="button" class="btn btn-primary" data-click-call="createOrganization">Добавить</button>
    </div>

</form>
