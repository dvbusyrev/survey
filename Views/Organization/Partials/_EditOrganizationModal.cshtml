<div id="editOrganizationModal" class="modal organization-modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="h2_modal">Редактирование организации</h2>
            <button type="button" class="modal-close" data-modal-close="editOrganizationModal"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="modal-body">
            <section class="app-section app-page__section app-page__stack">
                <input type="hidden" id="editOrganizationId">
                <div class="app-field-group">
                    <label>Название организации</label>
                    <input type="text" id="organizationName" class="app-field" placeholder="Введите название организации">
                </div>
                <div class="app-field-group">
                    <label>Краткое название</label>
                    <input type="text" id="organizationShortName" class="app-field" placeholder="Введите краткое название">
                </div>
                <div class="app-field-group">
                    <label for="organizationEmail">Эл. почта</label>
                    <div class="app-field-with-icon">
                        <div class="icon-container field-icon-container"><i class="fas fa-envelope"></i></div>
                        <input type="email" id="organizationEmail" class="app-field" placeholder="Введите эл. почту">
                    </div>
                </div>
                <div class="app-field-group">
                    <label>Дата начала</label>
                    <input type="date" id="organizationDateBegin" class="app-field" data-date-native="true" data-date-label="Дата начала" lang="ru-RU" required>
                </div>
                <div class="app-field-group">
                    <label>Дата конца</label>
                    <input type="date" id="organizationDateEnd" class="app-field" data-date-native="true" data-date-label="Дата конца" lang="ru-RU">
                </div>
            </section>
        </div>
        <div class="modal-footer">
            <button type="button" data-modal-close="editOrganizationModal" class="app-button app-button--secondary">Отмена</button>
            <button type="button" id="saveOrganizationBtn" data-click-call="updateOrganization" class="app-button app-button--primary">Сохранить</button>
        </div>
    </div>
</div>
