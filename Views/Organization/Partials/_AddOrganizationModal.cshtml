<div id="addOrganizationModal" class="modal organization-modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="h2_modal">Добавление организации</h2>
            <button type="button" class="modal-close" data-modal-close="addOrganizationModal"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="modal-body">
            <form id="organizationForm">
                @Html.AntiForgeryToken()
                <section class="app-section app-page__section app-page__stack">
                    <div class="app-field-group">
                        <label for="Name">Название организации</label>
                        <input type="text" class="app-field" id="Name" placeholder="Введите название организации" required data-required-message="Введите название организации.">
                    </div>

                    <div class="app-field-group">
                        <label for="ShortName">Краткое название</label>
                        <input type="text" class="app-field" id="ShortName" placeholder="Введите краткое название">
                    </div>

                    <div class="app-field-group">
                        <label for="organization_email">Эл. почта</label>
                        <div class="app-field-with-icon">
                            <div class="icon-container field-icon-container"><i class="fas fa-envelope"></i></div>
                            <input type="email" class="app-field" id="organization_email" placeholder="Введите эл. почту">
                        </div>
                    </div>

                    <div class="app-field-group">
                        <label for="DateBegin">Дата начала</label>
                        <input type="date" class="app-field" id="DateBegin" data-date-native="true" data-date-label="Дата начала" lang="ru-RU" required data-required-message="Укажите дату начала.">
                    </div>

                    <div class="app-field-group">
                        <label for="DateEnd">Дата конца</label>
                        <input type="date" class="app-field" id="DateEnd" data-date-native="true" data-date-label="Дата конца" lang="ru-RU">
                    </div>
                </section>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="app-button app-button--secondary" data-modal-close="addOrganizationModal">Отмена</button>
            <button type="button" class="app-button app-button--primary" data-click-call="createOrganization">Сохранить</button>
        </div>
    </div>
</div>
