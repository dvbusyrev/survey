@using System.Text.Json
@inject MainProject.Application.UseCases.Admin.ThemeSettingsService ThemeSettingsService
@{
    Layout = null;
    var layoutThemeSettings = await ThemeSettingsService.GetAsync();
    var layoutThemeJson = JsonSerializer.Serialize(layoutThemeSettings);
    var inlineBackgroundImage = string.IsNullOrWhiteSpace(layoutThemeSettings.BackgroundImageDataUrl)
        ? "none"
        : $"url('{layoutThemeSettings.BackgroundImageDataUrl.Replace("'", "\\'")}')";
    var inlineImageOpacity = (Math.Clamp(layoutThemeSettings.BackgroundImageOpacity, 0, 100) / 100d)
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

<!DOCTYPE html>
<html lang="ru-RU">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Авторизация</title>

    <link rel="icon" type="image/svg+xml" href="~/images/icon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/app-reset.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/app-foundation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/app-ui-utilities.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/app-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/app-modals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/site-notifications.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/local-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/app-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/auth-page.css" asp-append-version="true" />
    <style id="app-theme-inline">
        :root {
            --app-theme-font-color: @layoutThemeSettings.FontColor;
            --app-theme-background-color: @layoutThemeSettings.BackgroundColor;
            --app-theme-background-start-color: @layoutThemeSettings.BackgroundColor;
            --app-theme-background-end-color: @layoutThemeSettings.BackgroundColor;
            --app-theme-gradient-opacity: 0;
            --app-theme-background-image: @Html.Raw(inlineBackgroundImage);
            --app-theme-background-image-opacity: @inlineImageOpacity;
        }

        body {
            background: transparent !important;
        }

        #app-theme-background {
            background: @layoutThemeSettings.BackgroundColor !important;
        }

        #app-theme-background::before {
            background: none !important;
            opacity: 0 !important;
        }
    </style>
    <script id="app-theme-config" type="application/json">@Html.Raw(layoutThemeJson)</script>
    <script src="~/js/core/app-theme.js" asp-append-version="true"></script>
</head>
<body>
    <div id="app-theme-background" aria-hidden="true"></div>
    <div id="app-theme-effects-root" aria-hidden="true"></div>
    <div id="global-antiforgery-token" hidden aria-hidden="true">
        @Html.AntiForgeryToken()
    </div>
    <div id="root"></div>
    <template id="auth-login-template">
        <div class="content">
            <div class="inner-container modal-content auth-modal-content">
                <form id="loginForm" class="auth-modal-form">
                    <header class="modal-header auth-modal-header">
                        <h1 class="modal-title auth-modal-title">Анкетирование</h1>
                    </header>

                    <div class="modal-body auth-modal-body">
                        <div class="app-field-group">
                            <label for="username">Логин</label>
                            <div class="app-field-with-icon">
                                <div class="icon-container field-icon-container"><i class="fas fa-user"></i></div>
                                <input type="text" class="app-field" id="username" name="username" required placeholder="Введите логин" />
                            </div>
                        </div>

                        <div class="app-field-group">
                            <label for="password">Пароль</label>
                            <div class="app-field-with-icon has-toggle">
                                <div class="icon-container field-icon-container"><i class="fas fa-lock"></i></div>
                                <input
                                    type="text"
                                    class="app-field is-password-masked"
                                    id="password"
                                    name="password"
                                    required
                                    autoComplete="current-password"
                                    autoCapitalize="none"
                                    autoCorrect="off"
                                    spellcheck="false"
                                    inputmode="text"
                                    lang="ru"
                                    data-password-field="true"
                                    placeholder="Введите пароль" />
                                <button type="button" class="password-toggle-btn" aria-label="Показать пароль" title="Показать пароль"></button>
                            </div>
                        </div>
                    </div>

                    <footer class="modal-footer auth-modal-footer">
                        <button type="reset" class="app-button app-button--secondary">Сброс</button>
                        <button type="submit" class="app-button app-button--primary">Войти</button>
                    </footer>
                </form>
            </div>
        </div>
    </template>
    <template id="auth-eye-open-template">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>
            <circle cx="12" cy="12" r="3"></circle>
        </svg>
    </template>
    <template id="auth-eye-closed-template">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 3l18 18"></path>
            <path d="M10.6 10.7a3 3 0 0 0 4 4"></path>
            <path d="M9.9 5.2A11 11 0 0 1 12 5c6.5 0 10 7 10 7a17.3 17.3 0 0 1-4.1 4.8"></path>
            <path d="M6.6 6.7A17.7 17.7 0 0 0 2 12s3.5 7 10 7a10.8 10.8 0 0 0 5.2-1.3"></path>
        </svg>
    </template>

    <script src="~/js/core/notifications.js" asp-append-version="true"></script>
    <script src="~/js/core/app-page-lifecycle.js" asp-append-version="true"></script>
    <script src="~/js/core/antiforgery.js" asp-append-version="true"></script>
    <script type="module" src="~/js/entries/auth-page.js" asp-append-version="true"></script>
</body>
</html>
