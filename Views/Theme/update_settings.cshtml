@model MainProject.Application.DTO.Theme.ThemeSettings

@{
    ViewData["Title"] = "Настройка темы";
    ViewData["SettingsSection"] = "theme";
    var settings = Model ?? new MainProject.Application.DTO.Theme.ThemeSettings();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/admin-utility-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/theme-settings-page.css" asp-append-version="true" />
}

<div class="app-page email-settings-page theme-settings-page" id="default_content" data-page="theme-settings-page">
    @await Html.PartialAsync("~/Views/Shared/_SettingsSubnav.cshtml")
    @await Html.PartialAsync(
        "~/Views/Shared/_PageIntro.cshtml",
        new MainProject.Web.ViewModels.PageIntroModel
        {
            Description = "Здесь можно задать основной цвет темы, цвет текста, фон, дополнительные визуальные эффекты и фоновое изображение. Изменения применяются сразу на странице и сохраняются только после кнопки «Сохранить»."
        })

    <div class="reports-page__grid theme-settings-page__layout">
        <section class="app-section app-page__section reports-page__card theme-settings-page__card">
            <div class="reports-page__card-header">
                <h3 class="reports-page__card-title">Настройка</h3>
            </div>

            <div class="email-settings-page__form theme-settings-page__form">
                <div class="app-field-group theme-settings-page__form-group theme-settings-page__main-row">
                    <label for="theme-font-color">Цвет шрифта</label>
                    <div class="app-field theme-settings-page__color-field"
                         data-theme-color-field
                         style="background-color: @settings.FontColor">
                        <input type="color"
                               class="theme-settings-page__color-input"
                               id="theme-font-color"
                               value="@settings.FontColor" />
                    </div>
                </div>

                <div class="app-field-group theme-settings-page__form-group theme-settings-page__main-row">
                    <label for="theme-background-color">Цвет фона</label>
                    <div class="app-field theme-settings-page__color-field"
                         data-theme-color-field
                         style="background-color: @settings.BackgroundColor">
                        <input type="color"
                               class="theme-settings-page__color-input"
                               id="theme-background-color"
                               value="@settings.BackgroundColor" />
                    </div>
                </div>

                <div class="app-field-group theme-settings-page__form-group theme-settings-page__main-row">
                    <label for="theme-header-darken-percent">Шапка</label>
                    <div class="theme-settings-page__range-field">
                        <input type="range"
                               id="theme-header-darken-percent"
                               min="0"
                               max="100"
                               value="@settings.HeaderDarkenPercent" />
                        <span id="theme-header-darken-percent-value">@settings.HeaderDarkenPercent%</span>
                    </div>
                </div>

                <div class="app-field-group theme-settings-page__form-group theme-settings-page__main-row">
                    <label for="theme-button-darken-percent">Кнопки</label>
                    <div class="theme-settings-page__range-field">
                        <input type="range"
                               id="theme-button-darken-percent"
                               min="0"
                               max="100"
                               value="@settings.ButtonDarkenPercent" />
                        <span id="theme-button-darken-percent-value">@settings.ButtonDarkenPercent%</span>
                    </div>
                </div>

                <div class="app-field-group theme-settings-page__form-group theme-settings-page__main-row">
                    <label for="theme-surface-tint-opacity-percent">Таблица</label>
                    <div class="theme-settings-page__range-field">
                        <input type="range"
                               id="theme-surface-tint-opacity-percent"
                               min="0"
                               max="100"
                               value="@settings.SurfaceTintOpacityPercent" />
                        <span id="theme-surface-tint-opacity-percent-value">@settings.SurfaceTintOpacityPercent%</span>
                    </div>
                </div>

                <div class="app-field-group theme-settings-page__form-group theme-settings-page__main-row">
                    <label for="theme-footer-darken-percent">Подвал</label>
                    <div class="theme-settings-page__range-field">
                        <input type="range"
                               id="theme-footer-darken-percent"
                               min="0"
                               max="100"
                               value="@settings.FooterDarkenPercent" />
                        <span id="theme-footer-darken-percent-value">@settings.FooterDarkenPercent%</span>
                    </div>
                </div>

                <div class="theme-settings-page__additional-settings">
                    <div class="app-field-group theme-settings-page__form-group theme-settings-page__form-group--file">
                        <label for="theme-background-image-upload">Фоновое изображение</label>
                        <input type="text"
                               class="app-field theme-settings-page__file-field @(string.IsNullOrWhiteSpace(settings.BackgroundImageFileName) ? "app-field-placeholder" : null)"
                               id="theme-background-image-name"
                               value="@(string.IsNullOrWhiteSpace(settings.BackgroundImageFileName) ? "Изображение не выбрано" : settings.BackgroundImageFileName)"
                               readonly />
                        <input type="file"
                               class="theme-settings-page__file-input"
                               id="theme-background-image-file"
                               accept="image/png,image/jpeg,image/jpg,image/webp"
                               hidden />
                        <input type="hidden"
                               id="theme-background-image-data-url"
                               value="@settings.BackgroundImageDataUrl" />
                        <input type="hidden"
                               id="theme-background-image-file-name"
                               value="@settings.BackgroundImageFileName" />
                        <button type="button"
                                id="theme-background-image-upload"
                                class="app-button app-button--primary theme-settings-page__field-button">
                            Загрузить изображение
                        </button>
                    </div>

                    <div class="app-field-group theme-settings-page__form-group">
                        <label for="theme-background-image-opacity">Непрозрачность изображения</label>
                        <div class="theme-settings-page__range-field">
                            <input type="range"
                                   id="theme-background-image-opacity"
                                   min="0"
                                   max="100"
                                   value="@settings.BackgroundImageOpacity" />
                            <span id="theme-background-image-opacity-value">@settings.BackgroundImageOpacity%</span>
                        </div>
                    </div>

                    <div class="app-field-group theme-settings-page__form-group theme-settings-page__form-group--effects">
                        <label>Эффекты</label>
                        <div class="app-multiselect app-checkbox-dropdown app-multiselect--inline app-checkbox-dropdown--inline theme-settings-page__effects-picker">
                            <div class="app-field theme-settings-page__selected-effects" id="theme-effects-summary" aria-live="polite">
                                <span class="app-field-placeholder theme-settings-page__empty-selection">Эффекты не выбраны</span>
                            </div>
                            <button type="button"
                                    class="app-button app-button--primary theme-settings-page__field-button theme-settings-page__effects-trigger"
                                    id="theme-effects-toggle"
                                    aria-expanded="false"
                                    aria-controls="theme-effects-dropdown">
                                Выбрать эффекты
                            </button>
                            <div class="app-multiselect__menu app-checkbox-dropdown__menu app-multiselect__menu--inline app-checkbox-dropdown__menu--inline theme-settings-page__effects-dropdown is-hidden"
                                 id="theme-effects-dropdown">
                                <div class="app-checkbox-list">
                                    <label class="app-checkbox-option" for="theme-effect-snow">
                                        <input type="checkbox" id="theme-effect-snow" class="app-checkbox-input" @(settings.EffectSnow ? "checked" : null) />
                                        <span class="app-checkbox-text">Снег</span>
                                    </label>
                                    <label class="app-checkbox-option" for="theme-effect-fireworks">
                                        <input type="checkbox" id="theme-effect-fireworks" class="app-checkbox-input" @(settings.EffectFireworks ? "checked" : null) />
                                        <span class="app-checkbox-text">Салюты при нажатии</span>
                                    </label>
                                    <label class="app-checkbox-option" for="theme-effect-grass">
                                        <input type="checkbox" id="theme-effect-grass" class="app-checkbox-input" @(settings.EffectGrass ? "checked" : null) />
                                        <span class="app-checkbox-text">Трава</span>
                                    </label>
                                    <label class="app-checkbox-option" for="theme-effect-rain">
                                        <input type="checkbox" id="theme-effect-rain" class="app-checkbox-input" @(settings.EffectRain ? "checked" : null) />
                                        <span class="app-checkbox-text">Дождь</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="app-section app-page__section reports-page__card theme-settings-page__card theme-settings-page__preview-card">
            <div class="reports-page__card-header">
                <h3 class="reports-page__card-title">Как выглядит</h3>
            </div>

            <div class="theme-settings-page__preview-list">
                <div class="theme-settings-page__preview-row theme-settings-page__main-row">
                    <span class="theme-settings-page__preview-label">Цвет шрифта</span>
                    <div class="app-field theme-settings-page__preview-field theme-settings-page__preview-field--font">Пример</div>
                </div>

                <div class="theme-settings-page__preview-row theme-settings-page__main-row">
                    <span class="theme-settings-page__preview-label">Цвет фона</span>
                    <div class="app-field theme-settings-page__preview-field theme-settings-page__preview-field--background">Пример</div>
                </div>

                <div class="theme-settings-page__preview-row theme-settings-page__main-row">
                    <span class="theme-settings-page__preview-label">Шапка</span>
                    <div class="app-field theme-settings-page__preview-field theme-settings-page__preview-field--header">Пример</div>
                </div>

                <div class="theme-settings-page__preview-row theme-settings-page__main-row">
                    <span class="theme-settings-page__preview-label">Кнопки</span>
                    <div class="app-field theme-settings-page__preview-field theme-settings-page__preview-button-field">
                        <button type="button" class="app-button app-button--primary theme-settings-page__preview-button">Пример</button>
                    </div>
                </div>

                <div class="theme-settings-page__preview-row theme-settings-page__main-row">
                    <span class="theme-settings-page__preview-label">Таблица</span>
                    <table class="app-table theme-settings-page__preview-table" aria-label="Пример таблицы">
                        <thead>
                        <tr>
                            <th>ПРИМЕР</th>
                        </tr>
                        </thead>
                    </table>
                </div>

                <div class="theme-settings-page__preview-row theme-settings-page__main-row">
                    <span class="theme-settings-page__preview-label">Подвал</span>
                    <div class="app-field theme-settings-page__preview-field theme-settings-page__preview-field--footer">Пример</div>
                </div>
            </div>
        </section>
    </div>

    <div class="email-settings-page__actions theme-settings-page__actions">
        <button type="button" id="theme-reset-button" class="app-button app-button--secondary">Сброс</button>
        <button type="button" id="theme-save-button" class="app-button app-button--primary">Сохранить</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/features/theme/theme-settings-page.js" asp-append-version="true"></script>
}
