@model MainProject.Web.ViewModels.UserTableViewModel
@using MainProject.Infrastructure.Security

@{
    var users = Model?.Users ?? Array.Empty<MainProject.Domain.Entities.User>();
    var showActions = Model?.ShowActions ?? false;
}

<table id="@Model?.TableId"
       class="users-table"
       data-role="main-table"
       data-disable-column-sort="true">
    <thead>
        <tr class="app-table__header-row">
            <th class="table-th--start table-sortable @(string.IsNullOrWhiteSpace(Model?.NameSortDirection) ? string.Empty : "is-sorted")"
                data-sort-direction="@Model?.NameSortDirection"
                aria-sort="@Model?.NameAriaSort">
                <a class="logs-table__sort-link" href="@Model?.NameSortUrl">ФИО</a>
            </th>
            <th class="table-sortable @(string.IsNullOrWhiteSpace(Model?.OrganizationSortDirection) ? string.Empty : "is-sorted")"
                data-sort-direction="@Model?.OrganizationSortDirection"
                aria-sort="@Model?.OrganizationAriaSort">
                <a class="logs-table__sort-link" href="@Model?.OrganizationSortUrl">Организация</a>
            </th>
            <th class="table-sortable @(string.IsNullOrWhiteSpace(Model?.RoleSortDirection) ? string.Empty : "is-sorted")"
                data-sort-direction="@Model?.RoleSortDirection"
                aria-sort="@Model?.RoleAriaSort">
                <a class="logs-table__sort-link" href="@Model?.RoleSortUrl">Роль</a>
            </th>
            <th class="table-col--date table-sortable @(string.IsNullOrWhiteSpace(Model?.DateBeginSortDirection) ? string.Empty : "is-sorted")"
                data-sort-direction="@Model?.DateBeginSortDirection"
                aria-sort="@Model?.DateBeginAriaSort">
                <a class="logs-table__sort-link" href="@Model?.DateBeginSortUrl">Дата начала</a>
            </th>
            <th class="table-col--date table-sortable @(string.IsNullOrWhiteSpace(Model?.DateEndSortDirection) ? string.Empty : "is-sorted")"
                data-sort-direction="@Model?.DateEndSortDirection"
                aria-sort="@Model?.DateEndAriaSort">
                <a class="logs-table__sort-link" href="@Model?.DateEndSortUrl">Дата конца</a>
            </th>
            <th class="table-th--end table-col--actions">Действия</th>
        </tr>
    </thead>
    <tbody>
        @if (!users.Any())
        {
            <tr>
                <td colspan="6" class="table-empty-cell">Результаты не найдены!</td>
            </tr>
        }
        else
        {
            @foreach (var user in users)
            {
                <tr data-role="user-row"
                    data-hover-label="Смотреть"
                    data-user-id="@user.IdUser"
                    data-user-full-name="@(user.FullName ?? string.Empty)"
                    data-user-name="@(user.NameUser ?? string.Empty)"
                    data-user-email="@(user.Email ?? string.Empty)"
                    data-user-organization-id="@user.OrganizationId"
                    data-user-organization-name="@(user.OrganizationName ?? string.Empty)"
                    data-user-role="@AppRoles.Normalize(user.NameRole)"
                    data-user-role-name="@AppRoles.GetDisplayName(user.NameRole)"
                    data-user-date-begin="@(user.DateBegin?.ToString("yyyy-MM-dd") ?? string.Empty)"
                    data-user-date-begin-display="@(user.DateBegin?.ToString("dd.MM.yyyy") ?? string.Empty)"
                    data-user-date-end="@(user.DateEnd?.ToString("yyyy-MM-dd") ?? string.Empty)"
                    data-user-date-end-display="@(user.DateEnd?.ToString("dd.MM.yyyy") ?? string.Empty)">
                    <td>@(string.IsNullOrWhiteSpace(user.FullName) ? "Не указано" : user.FullName)</td>
                    <td>@(string.IsNullOrWhiteSpace(user.OrganizationName) ? "Не указано" : user.OrganizationName)</td>
                    <td>@AppRoles.GetDisplayName(user.NameRole)</td>
                    <td class="table-col--date">@(user.DateBegin?.ToString("dd.MM.yyyy") ?? "")</td>
                    <td class="table-col--date">@(user.DateEnd?.ToString("dd.MM.yyyy") ?? "")</td>
                    <td class="action-icons table-col--actions">
                        @if (showActions)
                        {
                            <div class="action-icons__content">
                                <div class="icon-container"
                                     data-user-id="@user.IdUser"
                                     data-user-full-name="@(user.FullName ?? string.Empty)"
                                     data-user-name="@(user.NameUser ?? string.Empty)"
                                     data-user-email="@(user.Email ?? string.Empty)"
                                     data-user-organization-id="@user.OrganizationId"
                                     data-user-role="@AppRoles.Normalize(user.NameRole)"
                                     data-user-date-begin="@(user.DateBegin?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                     data-user-date-end="@(user.DateEnd?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                     data-click-call="openEditUserModalFromTrigger"
                                     data-click-pass-element="true"
                                     aria-label="Редактировать">
                                    <span><i class="fas fa-pen-to-square"></i></span>
                                    <span class="icon-tooltip">Редактировать</span>
                                </div>
                                <div class="icon-container"
                                     data-user-id="@user.IdUser"
                                     data-user-full-name="@(user.FullName ?? string.Empty)"
                                     data-click-call="deleteUserFromTrigger"
                                     data-click-pass-element="true">
                                    <span><i class="fas fa-trash"></i></span>
                                    <span class="icon-tooltip">Удалить</span>
                                </div>
                            </div>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
