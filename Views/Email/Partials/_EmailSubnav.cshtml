@{
    var activeSection = (ViewData["EmailSection"] as string ?? "new").ToLowerInvariant();
    var newActive = activeSection == "new";
    var settingsActive = activeSection == "settings";
}

<div class="app-tabs app-page__subnav" role="tablist" aria-label="Разделы электронной почты">
    <a
        href="/email"
        class="app-tab @(newActive ? "active-tab" : "")"
        role="tab"
        aria-selected="@(newActive ? "true" : "false")"
        data-tab-target="email_new">
        Новое отправление
    </a>
    <a
        href="/settings/email"
        class="app-tab @(settingsActive ? "active-tab" : "")"
        role="tab"
        aria-selected="@(settingsActive ? "true" : "false")"
        data-tab-target="email_settings">
        Настройки отправителя
    </a>
</div>
