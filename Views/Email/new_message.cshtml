@model MainProject.Application.DTO.Email.EmailMessageSettings

@{
    ViewData["Title"] = "Электронная почта";
    var settings = Model ?? new MainProject.Application.DTO.Email.EmailMessageSettings();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/admin-utility-pages.css" asp-append-version="true" />
}

<div class="app-page email-settings-page" id="default_content" data-page="mail-compose">
    @await Html.PartialAsync(
        "~/Views/Shared/_PageIntro.cshtml",
        new MainProject.Web.ViewModels.PageIntroModel
        {
            Title = "Электронная почта",
            Description = "Здесь можно подготовить письмо и отправить его по сохранённому SMTP-профилю."
        })

    <section class="app-section app-page__section">
        <div class="email-settings-page__grid email-settings-page__grid--single">
            <div class="email-settings-page__panel">
                <div class="email-settings-page__form">
                    <div class="app-field-group email-settings-page__form-group">
                        <label for="email-to">Кому</label>
                        <input type="text"
                               class="app-field"
                               id="email-to"
                               value="@settings.To"
                               placeholder="Введите адреса получателей" />
                    </div>
                    <div class="app-field-group email-settings-page__form-group">
                        <label for="email-subject">Тема</label>
                        <input type="text"
                               class="app-field"
                               id="email-subject"
                               value="@settings.Subject"
                               placeholder="Введите тему письма" />
                    </div>
                    <div class="app-field-group email-settings-page__form-group email-settings-page__form-group--textarea">
                        <label for="email-content">Содержание</label>
                        <textarea id="email-content"
                                  class="app-field"
                                  placeholder="Введите текст письма">@settings.Content</textarea>
                    </div>
                </div>
            </div>
        </div>

    </section>

    <div class="app-form-actions email-settings-page__actions">
        <button type="button" id="email-save-button" class="app-button app-button--secondary">Сохранить</button>
        <button type="button" id="email-send-button" class="app-button app-button--primary">Отправить</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/features/email/email-settings-page.js" asp-append-version="true"></script>
}
