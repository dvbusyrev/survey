@model MainProject.Application.DTO.Email.EmailSenderSettings

@{
    ViewData["Title"] = "Настройки отправителя";
    ViewData["SettingsSection"] = "sender";
    var settings = Model ?? new MainProject.Application.DTO.Email.EmailSenderSettings();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/admin-utility-pages.css" asp-append-version="true" />
}

<div class="app-page email-settings-page" id="default_content" data-page="mail-settings-page">
    @await Html.PartialAsync("~/Views/Shared/_SettingsSubnav.cshtml")
    @await Html.PartialAsync(
        "~/Views/Shared/_PageIntro.cshtml",
        new MainProject.Web.ViewModels.PageIntroModel
        {
            // Title = "Настройка эл. почты",
            Description = "Здесь можно сохранить SMTP-профиль отправителя. Параметры хранятся в базе данных, а пароль SMTP сохраняется в защищённом виде."
        })

    <section class="app-section app-page__section">
        <div class="email-settings-page__grid email-settings-page__grid--single">
            <div class="email-settings-page__panel">
                <div class="app-form email-settings-page__form">
                    <div class="app-field-group">
                        <label for="email-smtp-host">SMTP сервер</label>
                        <div class="app-field-with-icon">
                            <div class="icon-container field-icon-container"><i class="fas fa-server"></i></div>
                            <input type="text"
                                   class="app-field"
                                   id="email-smtp-host"
                                   value="@settings.SmtpHost"
                                   placeholder="Введите SMTP сервер"
                                   required />
                        </div>
                    </div>
                    <div class="app-field-group">
                        <label for="email-smtp-port">Порт SMTP</label>
                        <div class="app-field-with-icon">
                            <div class="icon-container field-icon-container"><i class="fas fa-plug"></i></div>
                            <input type="number"
                                   class="app-field"
                                   id="email-smtp-port"
                                   min="1"
                                   max="65535"
                                   value="@settings.SmtpPort"
                                   placeholder="Введите порт SMTP"
                                   required />
                        </div>
                    </div>
                    <div class="app-field-group">
                        <label for="email-smtp-enable-ssl">SSL/TLS</label>
                        <div class="app-field-with-icon">
                            <div class="icon-container field-icon-container"><i class="fas fa-shield-halved"></i></div>
                            <select id="email-smtp-enable-ssl" class="app-field" required>
                                @if (settings.SmtpEnableSsl)
                                {
                                    <option value="true" selected>Включён</option>
                                    <option value="false">Выключен</option>
                                }
                                else
                                {
                                    <option value="true">Включён</option>
                                    <option value="false" selected>Выключен</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="app-field-group">
                        <label for="email-smtp-user-name">Логин SMTP</label>
                        <div class="app-field-with-icon">
                            <div class="icon-container field-icon-container"><i class="fas fa-user"></i></div>
                            <input type="text"
                                   class="app-field"
                                   id="email-smtp-user-name"
                                   value="@settings.SmtpUserName"
                                   placeholder="Введите логин SMTP"
                                   required />
                        </div>
                    </div>
                    <div class="app-field-group">
                        <label for="email-smtp-password">Пароль SMTP</label>
                        <div class="app-field-with-icon has-toggle">
                            <div class="icon-container field-icon-container"><i class="fas fa-lock"></i></div>
                            <input type="text"
                                   class="app-field is-password-masked"
                                   id="email-smtp-password"
                                   value="@settings.SmtpPassword"
                                   data-password-field="true"
                                   data-password-visible="false"
                                   autocomplete="current-password"
                                   inputmode="text"
                                   lang="ru"
                                   autocapitalize="none"
                                   spellcheck="false"
                                   placeholder="Введите пароль SMTP"
                                   required />
                            <button type="button" class="password-toggle-btn" aria-label="Показать пароль" title="Показать пароль"></button>
                        </div>
                    </div>
                    <div class="app-field-group">
                        <label for="email-from-address">Эл. почта отправителя</label>
                        <div class="app-field-with-icon">
                            <div class="icon-container field-icon-container"><i class="fas fa-envelope"></i></div>
                            <input type="email"
                                   class="app-field"
                                   id="email-from-address"
                                   value="@settings.FromAddress"
                                   placeholder="Введите эл. почту отправителя"
                                   required />
                        </div>
                    </div>
                    <div class="app-field-group">
                        <label for="email-from-display-name">Имя отправителя</label>
                        <div class="app-field-with-icon">
                            <div class="icon-container field-icon-container"><i class="fas fa-id-card"></i></div>
                            <input type="text"
                                   class="app-field"
                                   id="email-from-display-name"
                                   value="@settings.FromDisplayName"
                                   placeholder="Введите имя отправителя"
                                   required />
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>

    <div class="app-form-actions email-settings-page__actions">
        <button type="button" id="email-reset-button" class="app-button app-button--secondary">Сброс</button>
        <button type="button" id="email-save-button" class="app-button app-button--primary">Сохранить</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/features/email/email-settings-page.js" asp-append-version="true"></script>
}
