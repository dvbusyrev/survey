@model MainProject.Web.ViewModels.HelpPageViewModel

@{
    ViewData["Title"] = "Инструкции";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
    var isClient = !string.Equals(userRole, MainProject.Infrastructure.Security.AppRoles.Admin, System.StringComparison.OrdinalIgnoreCase);
    ViewData["ClientSurveySection"] = "help";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/admin-utility-pages.css" asp-append-version="true" />
}

<div class="app-page help-page" id="default_content" data-page="help-page">
    @if (isClient)
    {
        @await Html.PartialAsync("~/Views/Survey/Partials/_ClientSurveySubnav.cshtml")
    }

    @await Html.PartialAsync(
        "~/Views/Shared/_PageIntro.cshtml",
        new MainProject.Web.ViewModels.PageIntroModel
        {
            Title = "Справка",
            Description = "Здесь можно скачать текущую инструкцию и загрузить новую версию для администраторов или клиентов."
        })

    <section class="app-section app-page__section help-page__instructions">
        @await Html.PartialAsync("~/Views/Help/_InstructionFileRow.cshtml", Model.AdminInstruction)
        @await Html.PartialAsync("~/Views/Help/_InstructionFileRow.cshtml", Model.ClientInstruction)
    </section>
</div>

@section Scripts {
    <script src="~/js/features/help/help-page.js" asp-append-version="true"></script>
}
