@model MainProject.Web.ViewModels.HelpDocumentViewModel

@{
    ViewData["ClientSurveySection"] = "help";
    var activeCountSource = ViewData["ClientSurveyActiveCount"];
    var activeCount = int.TryParse(System.Convert.ToString(activeCountSource), out var parsedActiveCount)
        ? parsedActiveCount
        : 0;
}

<div class="client-surveys-page__content client-help-page__content"
     data-role="survey-user-content"
     data-active-tab="help"
     data-current-page="1"
     data-total-pages="1"
     data-total-count="0"
     data-active-count="@activeCount"
     data-search-term=""
     data-signed-only="false">
    @await Html.PartialAsync("~/Views/Survey/Partials/_ClientSurveySubnav.cshtml")



    <section class="app-section app-page__section client-help-page__section">
        <p class="help-page__message">
            В этом разделе можно скачать файл с инструкцией АИС &quot;Анкетирование&quot;.
        </p>
    </section>
    <div class="client-help-page__actions">
        <a class="app-button app-button--primary client-help-page__download"
           href="/help/download/user-guide">
            Скачать инструкцию
        </a>
    </div>

    <script type="application/json" data-role="survey-user-items">[]</script>
</div>
