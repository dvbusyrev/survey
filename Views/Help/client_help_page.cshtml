@model MainProject.Web.ViewModels.HelpDocumentViewModel

@{
    ViewData["Title"] = "Инструкции";
    ViewData["ClientSurveySection"] = "help";
    var bootstrapJson = ViewBag.SurveyUserBootstrapJson as string ?? "{}";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/survey-user.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/survey-admin-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin-utility-pages.css" asp-append-version="true" />
}

<div class="app-page help-page client-help-page"
     id="default_content"
     data-page="user-surveys"
     data-filter-hide-count-summary="true">
    @await Html.PartialAsync("~/Views/Help/_ClientHelpContent.cshtml", Model)
</div>
<div data-role="fill-modal-host"></div>
<div data-role="answers-modal-host"></div>

<script type="application/json" id="survey-user-list-bootstrap">@Html.Raw(bootstrapJson)</script>

@section Scripts {
    @await Html.PartialAsync("~/Views/Shared/_SurveyUserTemplates.cshtml")
    <script type="module" src="~/js/entries/survey-user-app.js" asp-append-version="true"></script>
}
