<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1b21cfcd-203c-4ce8-ba30-bb5a967869f0</UserSecretsId>
    <RunFrontendBuild Condition="'$(RunFrontendBuild)' == ''">false</RunFrontendBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="closedxml" Version="0.104.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="EPPlus" Version="7.5.2" />
    <PackageReference Include="itext7" Version="9.0.0" />
    <PackageReference Include="itext7.bouncy-castle-adapter" Version="9.0.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="9.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Npgsql" Version="9.0.2" />
    <PackageReference Include="questpdf" Version="2023.12.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.6" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Remove="tests/**/*" />
    <None Remove="tests/**/*" />
    <Content Remove="tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/Fonts/*.ttf" />
    <None Update="Assets/Fonts/LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Frontend bundles are committed to wwwroot/js/dist, so Node is only needed when regenerating them. -->
  <Target Name="BuildFrontendAssets" BeforeTargets="Build;Publish" Condition="'$(RunFrontendBuild)' == 'true' and Exists('$(MSBuildProjectDirectory)/package.json') and Exists('$(MSBuildProjectDirectory)/node_modules')">
    <Message Text="Building frontend assets with npm..." Importance="high" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
