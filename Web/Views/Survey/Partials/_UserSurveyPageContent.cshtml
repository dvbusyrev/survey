@model MainProject.Web.ViewModels.UserSurveyPageContentViewModel
@using System.Text.Json

@{
    var pageModel = Model ?? new MainProject.Web.ViewModels.UserSurveyPageContentViewModel();
    var surveysJson = JsonSerializer.Serialize(pageModel.Surveys);
    var paginationModel = pageModel.Pagination;
    ViewData["ClientSurveySection"] = pageModel.IsArchive ? "archived" : "active";
    ViewData["ClientSurveyActiveCount"] = pageModel.ActiveCount;
}

<div class="client-surveys-page__content"
     data-role="survey-user-content"
     data-active-tab="@pageModel.ActiveTab"
     data-current-page="@pageModel.CurrentPage"
     data-total-pages="@pageModel.TotalPages"
     data-total-count="@(pageModel.IsArchive ? pageModel.ArchivedCount : pageModel.ActiveCount)"
     data-search-term="@pageModel.SearchTerm"
     data-signed-only="@(pageModel.SignedOnly ? "true" : "false")">
    @await Html.PartialAsync("~/Web/Views/Survey/Partials/_ClientSurveySubnav.cshtml")

    <header class="app-page__intro">
        <p class="app-page__description" data-role="subtitle">@pageModel.Description</p>
    </header>

    @* <section class="app-page__section u-hidden" data-role="error"> *@
    @*     <div class="error-message"> *@
    @*         <span data-role="error-text"></span> *@
    @*     </div> *@
    @* </section> *@

    @if (pageModel.IsArchive)
    {
        <div class="app-page__toolbar survey-list-toolbar client-surveys-page__filter-toolbar">
            @await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveyDateFilter.cshtml")
            @await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveyNameFilter.cshtml")
        </div>
    }

    <section class="app-page__section u-hidden" data-role="loading">
        <div class="loading">Загрузка анкет...</div>
    </section>

    <div data-role="table-section">
        @await Html.PartialAsync(
            "~/Web/Views/Survey/Partials/_UserSurveyTable.cshtml",
            new MainProject.Web.ViewModels.UserSurveyTableViewModel
            {
                Surveys = pageModel.Surveys,
                IsArchive = pageModel.IsArchive
            })
    </div>

    @await Html.PartialAsync("~/Web/Views/Shared/_AppPagination.cshtml", paginationModel)

    <script type="application/json" data-role="survey-user-items">@Html.Raw(surveysJson)</script>
</div>
