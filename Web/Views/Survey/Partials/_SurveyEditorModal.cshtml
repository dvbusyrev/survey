@model MainProject.Web.ViewModels.SurveyListPageViewModel

@{
    var editPage = Model?.EditSurveyPage;
    var isEditMode = editPage != null;
    var selectedOrganizationNamesJson = isEditMode
        ? System.Text.Json.JsonSerializer.Serialize(editPage!.SelectedOrganizationNames)
        : "[]";
}

<div id="surveyEditorModal" class="modal survey-editor-modal">
    <div class="modal-content survey-editor-page">
        <div class="modal-header">
            <h2 class="h2_modal">@(isEditMode ? "Просмотр анкеты" : "Добавление анкеты")</h2>
            <button type="button"
                    class="modal-close"
                    data-click-call="closeSurveyEditorModal">
                <i class="fas fa-xmark"></i>
            </button>
        </div>
        <div class="modal-body">
            <section class="app-page__section app-page__stack">
                <h3 class="survey-editor-page__section-title">Основные параметры</h3>

                <div class="form-group">
                    <label for="surveyTitle">Название анкеты</label>
                    <input type="text"
                           class="form-control"
                           id="surveyTitle"
                           value="@(isEditMode ? editPage!.Survey.NameSurvey : string.Empty)"
                           placeholder="Введите название анкеты"
                           required />
                    @if (isEditMode)
                    {
                        <div class="error-message" id="titleError"></div>
                    }
                </div>

                <div class="form-group">
                    <label for="surveyDescription">Описание</label>
                    @if (isEditMode)
                    {
                        <textarea class="form-control" id="surveyDescription">@editPage!.Survey.Description</textarea>
                    }
                    else
                    {
                        <input type="text"
                               class="form-control"
                               id="surveyDescription"
                               value=""
                               placeholder="Введите описание анкеты"
                               required />
                    }
                </div>

                <div class="form-group">
                    <label for="startDate">Дата начала</label>
                    <input type="text"
                           class="form-control"
                           id="startDate"
                           data-date-format="dd.mm.yyyy"
                           data-date-label="Дата начала"
                           value="@(isEditMode ? editPage!.Survey.DateBegin.ToString("yyyy-MM-dd") : string.Empty)"
                           required />
                    @if (isEditMode)
                    {
                        <div class="error-message" id="startDateError"></div>
                    }
                </div>

                <div class="form-group">
                    <label for="endDate">Дата конца</label>
                    <input type="text"
                           class="form-control"
                           id="endDate"
                           data-date-format="dd.mm.yyyy"
                           data-date-label="Дата конца"
                           value="@(isEditMode ? editPage!.Survey.DateEnd.ToString("yyyy-MM-dd") : string.Empty)"
                           required />
                    @if (isEditMode)
                    {
                        <div class="error-message" id="endDateError"></div>
                    }
                </div>

                <div class="form-group">
                    <label>Организации</label>
                    <div >
                        @if (isEditMode)
                        {
                            <input type="hidden" id="selectedOrganizationIds" value="@string.Join(",", editPage!.SelectedOrganizationIds)" />
                        }
                        <div class="selected-organization survey-editor-page__selected-organizations"
                             data-role="selected-organizations-container">
                            <div class="survey-editor-page__selected-organizations-list"
                                 data-role="selected-organizations-list"></div>
                        </div>
                    </div>
                </div>
                <div class="survey-editor-page__actions">
                    <button type="button"
                            class="criteria-btn criteria-btn--info"
                            data-role="criteria-add"
                            data-click-call="@(isEditMode ? "surveyEditOpenOrganizationModal" : "openOrganizationModal")">
                        Выбрать организацию
                    </button>
                </div>
            </section>

            <section class="app-page__section app-page__stack survey-editor-page__criteria-step"
                     data-role="criteria-step">
                <h3 class="survey-editor-page__section-title">Критерии оценки</h3>

                <div class="survey-editor-page__criteria-list" data-role="criteria-list">
                    @if (isEditMode)
                    {
                        @for (var index = 0; index < editPage!.Criteria.Count; index++)
                        {
                            var criterion = editPage.Criteria[index];
                            var criterionNumber = index + 1;
                            <div class="form-group survey-editor-page__criteria-item">
                                <label for="criterion@criterionNumber">Критерий №@criterionNumber:</label>
                                <div class="survey-editor-page__criteria-control">
                                    <input type="text"
                                           class="form-control criteriy"
                                           id="criterion@criterionNumber"
                                           value="@criterion"
                                           placeholder="Введите критерий оценки"
                                           required />
                                    <button type="button"
                                            class="survey-editor-page__criteria-remove"
                                            aria-label="Удалить критерий №@criterionNumber"
                                            data-click-call="removeSurveyCriterion"
                                            data-click-pass-element="true">
                                        <i class="fas fa-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div class="error-message"></div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="form-group survey-editor-page__criteria-item">
                            <label for="criterion1">Критерий №1:</label>
                            <div class="survey-editor-page__criteria-control">
                                <input type="text"
                                       class="form-control criteriy"
                                       id="criterion1"
                                       placeholder="Введите критерий оценки"
                                       required />
                                <button type="button"
                                        class="survey-editor-page__criteria-remove"
                                        aria-label="Удалить критерий №1"
                                        data-click-call="removeSurveyCriterion"
                                        data-click-pass-element="true">
                                    <i class="fas fa-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="error-message"></div>
                        </div>
                    }
                </div>

                <div class="survey-editor-page__actions">
                    <button type="button"
                            class="criteria-btn criteria-btn--info"
                            data-role="criteria-add"
                            data-click-call="@(isEditMode ? "surveyEditAddCriteria" : "addRowCriteriy")">
                        Добавить критерий
                    </button>
                </div>
            </section>
        </div>
        <div class="modal-footer">
            <button type="button"
                    class="modal_btn modal_btn-primary"
                    data-role="survey-submit"
                    data-click-call="@(isEditMode ? "surveyEditUpdate" : "addSurvey")">
                Сохранить
            </button>
            <button type="button"
                    class="modal_btn modal_btn-secondary"
                    data-click-call="closeSurveyEditorModal">
                Отмена
            </button>
        </div>
    </div>
</div>

<div id="organizationModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="h2_modal">Выбор организаций</h2>
            <button type="button"
                    class="modal-close"
                    data-click-call="@(isEditMode ? "surveyEditCloseModal" : "closeModal")"
                    data-click-args='["organizationModal"]'>
                <i class="fas fa-xmark"></i>
            </button>
        </div>
        <div class="modal-body">
            <section class="app-page__section app-page__stack">
                @if (isEditMode)
                {
                    <div class="organization-list" id="organizationList">
                        @foreach (var organization in editPage!.AllOrganization)
                        {
                            var isSelected = editPage.SelectedOrganizationIds.Contains(organization.Id);
                            <div class="organization-item@(isSelected ? " selected" : string.Empty)"
                                 data-click-call="surveyEditToggleOrganizationSelection"
                                 data-click-pass-element="true"
                                 data-id="@organization.Id"
                                 data-name="@organization.Name"
                                 data-selected="@(isSelected ? "true" : "false")">
                                <input type="checkbox"
                                       id="org-@organization.Id"
                                       @(isSelected ? "checked" : null) />
                                <label for="org-@organization.Id">@organization.Name</label>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div id="loadingOrgs" class="survey-loading-block">
                        <div class="spinner"></div>
                        <p class="survey-loading-label">Загрузка организаций...</p>
                    </div>
                    <div id="organizationList" class="organization-list u-hidden"></div>
                }
            </section>
        </div>
        <div class="modal-footer">
            <button type="button"
                    class="modal_btn modal_btn-primary"
                    data-click-call="@(isEditMode ? "surveyEditSaveSelectedOrganization" : "saveSelectedOrganization")">
                Сохранить
            </button>
            <button type="button"
                    class="modal_btn modal_btn-secondary"
                    data-click-call="@(isEditMode ? "surveyEditCloseModal" : "closeModal")"
                    data-click-args='["organizationModal"]'>
                Отмена
            </button>
        </div>
    </div>
</div>

@if (isEditMode)
{
    <input type="hidden" id="surveyId" value="@editPage!.Survey.IdSurvey" />
    <template id="survey-edit-selected-organization-names">@selectedOrganizationNamesJson</template>
}

@Html.AntiForgeryToken()
@await Html.PartialAsync("~/Web/Views/Shared/_OperationNotification.cshtml")
@await Html.PartialAsync("~/Web/Views/Shared/_OperationLoadingOverlay.cshtml", "Идет обработка данных...")
