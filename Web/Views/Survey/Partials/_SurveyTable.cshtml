@using System.Text.Json
@model MainProject.Web.ViewModels.SurveyTableViewModel

@{
    var surveys = Model?.Surveys ?? Array.Empty<MainProject.Web.ViewModels.SurveyTableRowViewModel>();
    var isArchive = Model?.IsArchive ?? false;
}

<table class="surveys-table" data-role="main-table">
    <thead>
        <tr class="table_tr">
            <th class="table-th--start">Название</th>
            <th class="table-col--date">Дата начала</th>
            <th class="table-col--date">Дата конца</th>
            <th class="table-th--end table-col--actions">Действия</th>
        </tr>
    </thead>
    <tbody>
        @if (surveys.Count == 0)
        {
            <tr>
                <td colspan="4" class="table-empty-cell">Анкеты не найдены.</td>
            </tr>
        }
        else
        {
            <tr id="none_result" data-role="survey-filter-empty-row" class="is-hidden">
                <td colspan="4" class="table-empty-cell">Результаты не найдены!</td>
            </tr>

            @foreach (var survey in surveys)
            {
                var organizationNamesJson = JsonSerializer.Serialize(survey.OrganizationNames ?? Array.Empty<string>());
                <tr class="@(isArchive ? "active" : null)"
                    data-dblclick-call="openEditSurveyModalFromTrigger"
                    data-dblclick-pass-element="true"
                    data-survey-id="@survey.IdSurvey"
                    data-survey-name="@(survey.NameSurvey ?? string.Empty)"
                    data-survey-date-begin="@survey.DateBegin.ToString("yyyy-MM-dd")"
                    data-survey-date-end="@survey.DateEnd.ToString("yyyy-MM-dd")"
                    data-survey-organizations="@organizationNamesJson">
                    <td>
                        @survey.NameSurvey
                    </td>
                    <td class="table-col--date">
                        @survey.DateBegin.ToString("dd.MM.yyyy")
                    </td>
                    <td class="table-col--date">
                        @survey.DateEnd.ToString("dd.MM.yyyy")
                    </td>
                    <td class="action-icons table-col--actions">
                        <div class="action-icons__content">
                            <a class="icon-container"
                               href="/surveys/@survey.IdSurvey/signatures"
                               data-survey-id="@survey.IdSurvey"
                               data-survey-name="@(survey.NameSurvey ?? string.Empty)"
                               data-click-call="openSurveyCompletionModalFromTrigger"
                               data-click-pass-element="true"
                               data-fallback-url="/surveys/@survey.IdSurvey/signatures"
                               aria-label="Проверить прохождение">
                                <span aria-hidden="true"><i class="fas fa-list-check"></i></span>
                                <span class="icon-tooltip">Проверить прохождение</span>
                            </a>
                            <button type="button"
                                    class="icon-container"
                                    data-survey-id="@survey.IdSurvey"
                                    data-survey-name="@(survey.NameSurvey ?? string.Empty)"
                                    data-click-call="openSurveyExtensionModalFromTrigger"
                                    data-click-pass-element="true"
                                    aria-label="Продлить доступ">
                                <span aria-hidden="true"><i class="fas fa-hourglass-half"></i></span>
                                <span class="icon-tooltip">Продлить доступ</span>
                            </button>
                            @if (isArchive)
                            {
                                <button type="button"
                                        class="icon-container"
                                        data-survey-id="@survey.IdSurvey"
                                        data-survey-name="@(survey.NameSurvey ?? string.Empty)"
                                        data-click-call="openCopySurveyModalFromTrigger"
                                        data-click-pass-element="true"
                                        aria-label="Копировать">
                                    <span aria-hidden="true"><i class="fas fa-copy"></i></span>
                                    <span class="icon-tooltip">Копировать</span>
                                </button>
                                <a class="icon-container"
                                   href="/surveys/archive/@survey.IdSurvey/edit"
                                   aria-label="Посмотреть / обновить">
                                    <span aria-hidden="true"><i class="fas fa-pen-to-square"></i></span>
                                    <span class="icon-tooltip">Посмотреть / обновить</span>
                                </a>
                            }
                            else
                            {
                                <button type="button"
                                   class="icon-container"
                                   data-survey-id="@survey.IdSurvey"
                                   data-survey-name="@(survey.NameSurvey ?? string.Empty)"
                                   data-click-call="openCopySurveyModalFromTrigger"
                                   data-click-pass-element="true"
                                   aria-label="Копировать">
                                    <span aria-hidden="true"><i class="fas fa-copy"></i></span>
                                    <span class="icon-tooltip">Копировать</span>
                                </button>
                                <a class="icon-container"
                                   href="/surveys/@survey.IdSurvey/edit"
                                   aria-label="Посмотреть / обновить">
                                    <span aria-hidden="true"><i class="fas fa-pen-to-square"></i></span>
                                    <span class="icon-tooltip">Посмотреть / обновить</span>
                                </a>
                            }
                            <button type="button"
                                    class="icon-container"
                                    data-survey-id="@survey.IdSurvey"
                                    data-survey-name="@(survey.NameSurvey ?? string.Empty)"
                                    data-click-call="deleteSurveyFromTrigger"
                                    data-click-pass-element="true"
                                    aria-label="Удалить">
                                <span aria-hidden="true"><i class="fas fa-trash"></i></span>
                                <span class="icon-tooltip">Удалить</span>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
