@model MainProject.Web.ViewModels.SurveyAutoCreationPageViewModel
@using MainProject.Application.UseCases.Surveys
@using System.Security.Claims
@using MainProject.Infrastructure.Security
@{
    ViewData["Title"] = "Автоматическое создание анкет";
    ViewData["SettingsSection"] = "auto-creation";
    ViewData["RendersAppChrome"] = true;
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var userId = int.TryParse(userIdClaim, out var parsedUserId) ? parsedUserId : 0;
    var organizationName = User.FindFirst("organization_name")?.Value ?? string.Empty;
    var userName = User.FindFirst(ClaimTypes.Name)?.Value ?? string.Empty;
    var displayName = !string.IsNullOrWhiteSpace(organizationName) && !string.IsNullOrWhiteSpace(userName)
        ? $"{organizationName}: {userName}"
        : (!string.IsNullOrWhiteSpace(userName) ? userName : AppRoles.GetDisplayName(userRole));
    var monthWeekdayOptions = SurveyAutoCreationScheduleHelper.GetMonthWeekdayOptions();
    var endOffsetOptions = SurveyAutoCreationScheduleHelper.GetBusinessDayOffsetOptions();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/admin-utility-pages.css" asp-append-version="true" />
}

<div id="chrome-context"
     data-user-role="@userRole"
     data-user-id="@userId"
     data-display-name="@displayName"
     data-user-name="@userName"
     data-organization-name="@organizationName"
     hidden></div>

<div class="page-container">
    <div id="chrome-header"></div>
    <div class="admin-container">
        <div id="chrome-navigation"></div>
        <div id="content_admin">
            <div class="app-page survey-auto-creation-page" id="default_content" data-page="survey-auto-creation">
                @await Html.PartialAsync("~/Web/Views/Shared/_SettingsSubnav.cshtml")
                @await Html.PartialAsync(
                    "~/Web/Views/Shared/_PageIntro.cshtml",
                    new MainProject.Web.ViewModels.PageIntroModel
                    {
                        // Title = "Автоматическое создание анкет",
                        Description = "Настройте день создания новых копий анкет, день их открытия и срок закрытия в рабочих днях. После запуска система будет автоматически создавать копии выбранных анкет по расписанию."
                    })

                <section class="app-section app-page__section reports-page__card survey-auto-creation-page__card">
                    <div class="reports-page__card-header survey-auto-creation-page__header">
                        <div class="reports-page__field survey-auto-creation-page__status-field">
                            <label>Статус</label>
                            <div class="app-field survey-auto-creation-page__status-control"
                                 data-role="survey-auto-creation-status">
                                @(Model?.IsEnabled == true ? "В работе" : "Не запущен")
                            </div>
                        </div>
                    </div>

                    <div class="survey-auto-creation-page__controls">
                        <div class="reports-page__field">
                            <label for="surveyAutoCreationPattern">Создание анкеты</label>
                            <select id="surveyAutoCreationPattern" class="app-field reports-page__quarter-select">
                                @foreach (var option in monthWeekdayOptions)
                                {
                                    <option value="@option.Value" selected="@(Model?.CreationPattern == option.Value)">@option.Label</option>
                                }
                            </select>
                        </div>

                        <div class="reports-page__field">
                            <label for="surveyAutoCreationStartPattern">Дата начала</label>
                            <select id="surveyAutoCreationStartPattern" class="app-field reports-page__quarter-select">
                                @foreach (var option in monthWeekdayOptions)
                                {
                                    <option value="@option.Value" selected="@(Model?.StartPattern == option.Value)">@option.Label</option>
                                }
                            </select>
                        </div>

                        <div class="reports-page__field">
                            <label for="surveyAutoCreationEndOffset">Период действия</label>
                            <select id="surveyAutoCreationEndOffset" class="app-field reports-page__quarter-select">
                                <option value="" selected="@(Model?.EndOffsetBusinessDays == null)"></option>
                                @foreach (var option in endOffsetOptions)
                                {
                                    <option value="@option.Value" selected="@(Model?.EndOffsetBusinessDays == option.Value)">@option.Label</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="survey-auto-creation-page__selection">
                        <div class="survey-auto-creation-page__selection-title">Анкеты</div>
                        <div class="app-field survey-auto-creation-page__selected-list"
                             data-role="survey-auto-creation-selected-list"
                             aria-live="polite"></div>
                        <div class="survey-auto-creation-page__selection-action">
                            <div class="app-multiselect app-multiselect--inline app-checkbox-dropdown app-checkbox-dropdown--inline survey-auto-creation-page__survey-dropdown"
                                 data-role="survey-auto-creation-dropdown">
                                <button type="button"
                                        class="app-button app-button--primary app-multiselect__trigger app-checkbox-dropdown__trigger"
                                        data-role="survey-auto-creation-dropdown-trigger">
                                    Выбрать анкеты
                                </button>
                                <div id="surveyAutoCreationDropdownMenu"
                                     class="app-multiselect__menu app-checkbox-dropdown__menu app-multiselect__menu--inline app-checkbox-dropdown__menu--inline is-hidden"
                                     data-role="survey-auto-creation-dropdown-menu">
                                    <div id="surveyAutoCreationModalLoading" class="app-checkbox-empty u-hidden" aria-hidden="true"></div>
                                    <div id="surveyAutoCreationModalList" class="app-checkbox-list"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="survey-auto-creation-page__actions">
                        <button type="button"
                                class="app-button app-button--secondary survey-auto-creation-page__action-btn"
                                data-click-call="saveSurveyAutoCreationSettings">
                            Сохранить
                        </button>
                        @if (Model?.IsEnabled == true)
                        {
                            <button type="button"
                                    class="btn app-button app-button--primary survey-auto-creation-page__action-btn"
                                    data-click-call="stopSurveyAutoCreation">
                                Остановить
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn app-button app-button--primary survey-auto-creation-page__action-btn"
                                    data-click-call="startSurveyAutoCreation">
                                Запустить
                            </button>
                        }
                    </div>
                </section>
            </div>
        </div>
    </div>
    <div id="chrome-footer"></div>
</div>

<script id="survey-auto-creation-bootstrap" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        isEnabled = Model?.IsEnabled ?? false,
        selectedSurveys = Model?.SelectedSurveys ?? Array.Empty<MainProject.Web.ViewModels.SurveyAutoCreationSelectedSurveyViewModel>()
    }))
</script>

@section Scripts {
    <script src="~/js/features/admin/survey-auto-creation-page.js" asp-append-version="true"></script>
}
