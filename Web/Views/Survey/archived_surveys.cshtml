@model MainProject.Web.ViewModels.SurveyArchivePageViewModel
@{
    ViewData["Title"] = "Архив анкет";
    ViewData["SurveySection"] = "archive";
    var archivedSurveys = Model?.Surveys ?? Array.Empty<MainProject.Domain.Entities.ArchivedSurvey>();
    var surveyRows = archivedSurveys
        .Select(survey => new MainProject.Web.ViewModels.SurveyTableRowViewModel
        {
            IdSurvey = survey.IdSurvey,
            NameSurvey = survey.NameSurvey,
            DateBegin = survey.DateBegin,
            DateEnd = survey.DateEnd,
            OrganizationNames = (survey.OrganizationName ?? string.Empty)
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToArray()
        })
        .ToList();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/survey-admin-pages.css" asp-append-version="true" />
}

<div class="app-page"
     id="default_content"
     data-page="surveys-archive"
     data-filter-hide-count-summary="true">
    @await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveySubnav.cshtml")
    @await Html.PartialAsync(
        "~/Web/Views/Shared/_PageIntro.cshtml",
        new MainProject.Web.ViewModels.PageIntroModel
        {
            // Title = "Архив анкет",
            Description = "На этой странице вы можете посмотреть архивные анкеты."
        })

    <div class="app-page__toolbar survey-list-toolbar">
        @await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveyDateFilter.cshtml")
        @await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveyOrganizationFilter.cshtml")
        @await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveyNameFilter.cshtml")
    </div>

    @await Html.PartialAsync(
        "~/Web/Views/Survey/Partials/_SurveyTable.cshtml",
        new MainProject.Web.ViewModels.SurveyTableViewModel
        {
            Surveys = surveyRows,
            IsArchive = true
        })

</div>

@await Html.PartialAsync(
    "~/Web/Views/Survey/Partials/_SurveyEditorModal.cshtml",
    new MainProject.Web.ViewModels.SurveyListPageViewModel
    {
        EditSurveyPage = Model?.EditSurveyPage
    })

@section Scripts {
    @await Html.PartialAsync("~/Web/Views/Shared/_AdminInlineTemplates.cshtml")
    @await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveyEditorScripts.cshtml")
    <script src="~/js/features/admin/admin-survey-edit.js" asp-append-version="true"></script>
    <script src="~/js/features/admin/admin-inline-pages.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-admin-date-filter.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-admin-list.js" asp-append-version="true"></script>
}
