@model MainProject.Web.ViewModels.SurveyListPageViewModel
@using System.Security.Claims
@using MainProject.Infrastructure.Security
@{
    ViewData["Title"] = "Анкеты";
    ViewData["SurveySection"] = "list";
    ViewData["RendersAppChrome"] = true;
    var pageModel = Model ?? new MainProject.Web.ViewModels.SurveyListPageViewModel();
    var openAddSurveyModal = Model?.OpenAddSurveyModal ?? false;
    var editSurveyPage = Model?.EditSurveyPage;
    var surveyRows = pageModel.SurveyRows;
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var userId = int.TryParse(userIdClaim, out var parsedUserId) ? parsedUserId : 0;
    var organizationName = User.FindFirst("organization_name")?.Value ?? string.Empty;
    var userName = User.FindFirst(ClaimTypes.Name)?.Value ?? string.Empty;
    var displayName = !string.IsNullOrWhiteSpace(organizationName) && !string.IsNullOrWhiteSpace(userName)
        ? $"{organizationName}: {userName}"
        : (!string.IsNullOrWhiteSpace(userName) ? userName : AppRoles.GetDisplayName(userRole));
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/survey-admin-pages.css" asp-append-version="true" />
}

<div id="chrome-context"
     data-user-role="@userRole"
     data-user-id="@userId"
     data-display-name="@displayName"
     data-user-name="@userName"
     data-organization-name="@organizationName"
     hidden></div>

<div class="page-container">
<div id="chrome-header"></div>
<div class="admin-container">
    <div id="chrome-navigation"></div>
    <div id="content_admin">
        <div class="app-page"
             id="default_content"
             data-page="surveys-list"
             data-total-count="@pageModel.TotalCount"
             data-visible-count="@surveyRows.Count"
             data-table-scroll-target="#surveys-table-top"
             data-filter-hide-count-summary="true">
            @await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveySubnav.cshtml")
            @await Html.PartialAsync(
                "~/Web/Views/Shared/_PageIntro.cshtml",
                new MainProject.Web.ViewModels.PageIntroModel
                {
                    // Title = "Анкеты",
                    // Description = "Список активных анкет и действия по управлению."
                })

            <div class="app-page__toolbar survey-list-toolbar">
                @await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveyOrganizationFilter.cshtml")

                <button type="button"
                        class="btn app-button app-button--primary"
                        data-click-call="openAddSurveyModal">
                    Добавить анкету
                </button>
                @await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveyWorkPeriodControl.cshtml")
            </div>

            @await Html.PartialAsync(
                "~/Web/Views/Survey/Partials/_SurveyTable.cshtml",
                new MainProject.Web.ViewModels.SurveyTableViewModel
                {
                    Surveys = surveyRows,
                    IsArchive = false,
                    TableId = "surveys-table-top",
                    NameSortUrl = pageModel.BuildSortUrl(MainProject.Web.ViewModels.SurveyListSortFields.Name),
                    NameSortDirection = pageModel.GetHeaderSortDirection(MainProject.Web.ViewModels.SurveyListSortFields.Name),
                    NameAriaSort = pageModel.GetAriaSort(MainProject.Web.ViewModels.SurveyListSortFields.Name),
                    DateBeginSortUrl = pageModel.BuildSortUrl(MainProject.Web.ViewModels.SurveyListSortFields.DateBegin),
                    DateBeginSortDirection = pageModel.GetHeaderSortDirection(MainProject.Web.ViewModels.SurveyListSortFields.DateBegin),
                    DateBeginAriaSort = pageModel.GetAriaSort(MainProject.Web.ViewModels.SurveyListSortFields.DateBegin),
                    DateEndSortUrl = pageModel.BuildSortUrl(MainProject.Web.ViewModels.SurveyListSortFields.DateEnd),
                    DateEndSortDirection = pageModel.GetHeaderSortDirection(MainProject.Web.ViewModels.SurveyListSortFields.DateEnd),
                    DateEndAriaSort = pageModel.GetAriaSort(MainProject.Web.ViewModels.SurveyListSortFields.DateEnd)
                })

            @await Html.PartialAsync("~/Web/Views/Shared/_AppPagination.cshtml", pageModel.Pagination)

            <script type="application/json" data-role="server-filter-bootstrap">
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pageModel.FilterState))
            </script>
        </div>
    </div>
</div>
<div id="chrome-footer"></div>
</div>

@await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveyEditorModal.cshtml", Model)

@section Scripts {
    @await Html.PartialAsync("~/Web/Views/Shared/_AdminReportScripts.cshtml")
    @await Html.PartialAsync("~/Web/Views/Survey/Partials/_SurveyEditorScripts.cshtml")
    <script src="~/js/features/survey/survey-extension-modal.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-filter-popover.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-filter-summary.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-date-filter.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-checkbox-filter.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-row-filtering.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-admin-date-filter.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-work-period.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/survey-admin-list.js" asp-append-version="true"></script>
    <script src="~/js/features/survey/surveys-page.js" asp-append-version="true"></script>
}
