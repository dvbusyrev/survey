@model Survey
@using System.Security.Claims
@using System.Text.Json
@using MainProject.Infrastructure.Security
@{
    ViewData["Title"] = "Прохождение анкеты";
    ViewData["RendersAppChrome"] = true;
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var nameOrganization = User.FindFirst("organization_name")?.Value ?? "";
    var nameUser = User.FindFirst(ClaimTypes.Name)?.Value ?? "";
    var displayName = !string.IsNullOrWhiteSpace(nameOrganization) && !string.IsNullOrWhiteSpace(nameUser)
        ? $"{nameOrganization}: {nameUser}"
        : (!string.IsNullOrWhiteSpace(nameUser) ? nameUser : AppRoles.GetDisplayName(userRole));
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var userId = int.TryParse(userIdClaim, out var parsedUserId) ? parsedUserId : 0;
    var questions = ViewBag.Questions as List<Dictionary<string, object>> ?? new List<Dictionary<string, object>>();
    var surveyId = ViewBag.Id;
    var organizationId = ViewBag.Organization_id;
    var surveyFillBootstrapJson = JsonSerializer.Serialize(new
    {
        userId,
        userRole,
        organizationId,
        surveyId,
        displayName,
        userName = nameUser,
        organizationName = nameOrganization
    });

    string GetQuestionValue(Dictionary<string, object> question, string primaryKey, string secondaryKey, string fallback)
    {
        if (question.TryGetValue(primaryKey, out var primaryValue) && primaryValue is not null)
        {
            var text = primaryValue.ToString();
            if (!string.IsNullOrWhiteSpace(text))
            {
                return text;
            }
        }

        if (question.TryGetValue(secondaryKey, out var secondaryValue) && secondaryValue is not null)
        {
            var text = secondaryValue.ToString();
            if (!string.IsNullOrWhiteSpace(text))
            {
                return text;
            }
        }

        return fallback;
    }
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/survey-user.css" asp-append-version="true" />
}

<div class="page-container">
    <div id="chrome-header"></div>
    <div class="admin-container">
        <div id="chrome-navigation"></div>
        <div id="content_admin">
            <div class="app-page app-page--narrow survey-editor-page" id="default_content" data-page="survey-fill-standalone">
                <header class="app-page__intro">
                    <h1 class="app-page__title">Заполнение анкеты</h1>
                    <p class="app-page__description">Пожалуйста, оцените каждый вопрос по шкале от 1 до 5.</p>
                </header>
                    <div class="error-message u-hidden" data-role="error">
                        <span data-role="error-text"></span>
                    </div>
                    <div class="survey-user-question-list" data-role="questions">
                        @for (var index = 0; index < questions.Count; index += 1)
                        {
                            var question = questions[index];
                            var questionId = GetQuestionValue(question, "id", "Id", (index + 1).ToString());
                            var questionText = GetQuestionValue(question, "text", "Text", $"Вопрос {index + 1}");

                            <section class="app-section app-page__section survey-user-question-card user-survey-question"
                                     data-role="survey-question"
                                     data-question-id="@questionId">
                                <h3 class="survey-editor-page__section-title" data-role="question-title">@questionText</h3>
                                <div class="rating-buttons" data-role="ratings">
                                    @for (var rating = 1; rating <= 5; rating += 1)
                                    {
                                        <button type="button"
                                                class="btn_crit"
                                                data-role="rating-button"
                                                data-rating="@rating">
                                            @rating
                                        </button>
                                    }
                                </div>
                                <div class="comment-container u-hidden" data-role="comment-block">
                                    <label class="comment-label">Ваш комментарий</label>
                                    <textarea class="app-field"
                                              data-role="comment-input"
                                              placeholder="Напишите комментарий"></textarea>
                                </div>
                            </section>
                        }
                    </div>
                    <div class="button-container">
                        <button type="button" class="app-button app-button--primary" data-role="submit">
                            <span data-role="submit-label">Отправить ответы</span>
                        </button>
                    </div>
            </div>
        </div>
    </div>
    <div id="chrome-footer"></div>
</div>

<script type="application/json" id="survey-fill-bootstrap">@Html.Raw(surveyFillBootstrapJson)</script>

@section Scripts {
    <script type="module" src="~/js/entries/survey-fill-app.js" asp-append-version="true"></script>
}
