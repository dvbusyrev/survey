@model MainProject.Web.ViewModels.ReportsPageViewModel
@using System.Security.Claims
@using MainProject.Infrastructure.Security
@{
    ViewData["Title"] = "Отчёты";
    var availableYears = Model?.AvailableYears ?? Array.Empty<int>();
    var hasAvailableYears = availableYears.Count > 0;
    var monthOptions = new[]
    {
        new { Value = 1, Name = "Январь" },
        new { Value = 2, Name = "Февраль" },
        new { Value = 3, Name = "Март" },
        new { Value = 4, Name = "Апрель" },
        new { Value = 5, Name = "Май" },
        new { Value = 6, Name = "Июнь" },
        new { Value = 7, Name = "Июль" },
        new { Value = 8, Name = "Август" },
        new { Value = 9, Name = "Сентябрь" },
        new { Value = 10, Name = "Октябрь" },
        new { Value = 11, Name = "Ноябрь" },
        new { Value = 12, Name = "Декабрь" }
    };
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
    var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var userId = int.TryParse(userIdClaim, out var parsedUserId) ? parsedUserId : 0;
    var organizationName = User.FindFirst("organization_name")?.Value ?? string.Empty;
    var userName = User.FindFirst(ClaimTypes.Name)?.Value ?? string.Empty;
    var displayName = !string.IsNullOrWhiteSpace(organizationName) && !string.IsNullOrWhiteSpace(userName)
        ? $"{organizationName}: {userName}"
        : (!string.IsNullOrWhiteSpace(userName) ? userName : AppRoles.GetDisplayName(userRole));
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/admin-utility-pages.css" asp-append-version="true" />
}

<div id="chrome-context"
     data-user-role="@userRole"
     data-user-id="@userId"
     data-display-name="@displayName"
     data-user-name="@userName"
     data-organization-name="@organizationName"
     hidden></div>

<div class="page-container">
    <div id="chrome-header"></div>
    <div class="admin-container">
        <div id="chrome-navigation"></div>
        <div id="content_admin">
            <div class="app-page reports-page" id="default_content" data-page="reports">
                @await Html.PartialAsync(
                    "~/Web/Views/Shared/_PageIntro.cshtml",
                    new MainProject.Web.ViewModels.PageIntroModel
                    {
                        Title = "Отчёты",
                        Description = "Сформируйте квартальный или месячный отчёт по тем периодам, для которых в системе доступны анкеты. Если за выбранный период записей нет, система покажет ошибку и не создаст пустой файл."
                    })

                <div class="reports-page__grid">
                    <section class="app-section app-page__section reports-page__card">
                        <div class="reports-page__card-header">
                            <h3 class="reports-page__card-title">Отчёт за месяц</h3>
                        </div>

                        <div class="reports-page__controls">
                            <div class="reports-page__field">
                                <label for="reportMonth">Месяц</label>
                                <select id="reportMonth" class="app-field reports-page__quarter-select" @(hasAvailableYears ? null : "disabled")>
                                    @foreach (var month in monthOptions)
                                    {
                                        <option value="@month.Value">@month.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="reports-page__field">
                                <label for="reportMonthYear">Год</label>
                                <select id="reportMonthYear" class="app-field reports-page__quarter-select" @(hasAvailableYears ? null : "disabled")>
                                    @foreach (var year in availableYears)
                                    {
                                        <option value="@year">@year</option>
                                    }
                                </select>
                            </div>

                            <button type="button"
                                    class="btn reports-page__submit"
                                    data-click-call="submitMonthlyReport"
                                    @(hasAvailableYears ? null : "disabled")>
                                Сформировать отчёт
                            </button>
                        </div>
                    </section>

                    <section class="app-section app-page__section reports-page__card">
                        <div class="reports-page__card-header">
                            <h3 class="reports-page__card-title">Отчёт за квартал</h3>
                        </div>

                        <div class="reports-page__controls">
                            <div class="reports-page__field">
                                <label for="reportQuarter">Квартал</label>
                                <select id="reportQuarter" class="app-field reports-page__quarter-select" @(hasAvailableYears ? null : "disabled")>
                                    @for (var quarter = 1; quarter <= 4; quarter++)
                                    {
                                        <option value="@quarter">@quarter</option>
                                    }
                                </select>
                            </div>

                            <div class="reports-page__field">
                                <label for="reportQuarterYear">Год</label>
                                <select id="reportQuarterYear" class="app-field reports-page__quarter-select" @(hasAvailableYears ? null : "disabled")>
                                    @foreach (var year in availableYears)
                                    {
                                        <option value="@year">@year</option>
                                    }
                                </select>
                            </div>

                            <button type="button"
                                    class="btn reports-page__submit"
                                    data-click-call="submitQuarterlyReport"
                                    @(hasAvailableYears ? null : "disabled")>
                                Сформировать отчёт
                            </button>
                        </div>
                    </section>
                </div>

                @if (!hasAvailableYears)
                {
                    <section class="app-section app-page__section reports-page__empty-state">
                        <p class="reports-page__empty-text">В системе пока нет анкет с доступными периодами для формирования отчётов.</p>
                    </section>
                }
            </div>
        </div>
    </div>
    <div id="chrome-footer"></div>
</div>

@section Scripts {
    @await Html.PartialAsync("~/Web/Views/Shared/_AdminReportScripts.cshtml")
    <script>
        (function () {
            const contextNode = document.getElementById('chrome-context');
            const chromeContext = (typeof window.readAppChromeContext === 'function' && window.readAppChromeContext())
                || (contextNode ? {
                    userRole: contextNode.dataset.userRole || '',
                    userId: Number(contextNode.dataset.userId || 0),
                    displayName: contextNode.dataset.displayName || '',
                    userName: contextNode.dataset.userName || '',
                    organizationName: contextNode.dataset.organizationName || ''
                } : null);
            if (!chromeContext) {
                return;
            }

            if (typeof window.mountHeader === 'function') {
                window.mountHeader(document.getElementById('chrome-header'), {
                    userRole: chromeContext.userRole,
                    userId: chromeContext.userId,
                    displayName: chromeContext.displayName,
                    userName: chromeContext.userName,
                    organizationName: chromeContext.organizationName
                });
            }

            if (typeof window.mountNavigation === 'function') {
                window.mountNavigation(document.getElementById('chrome-navigation'), {
                    activeTab: 'reports',
                    userRole: chromeContext.userRole,
                    userId: chromeContext.userId
                });
            }

            if (typeof window.mountFooter === 'function') {
                window.mountFooter(document.getElementById('chrome-footer'));
            }
        })();
    </script>
}
