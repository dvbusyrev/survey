<div class="modal logs-modal" id="logEntryModal" aria-hidden="true">
    <div class="modal-content">
        <button type="button" class="modal-close" aria-label="Закрыть">
            <i class="fas fa-xmark" aria-hidden="true"></i>
        </button>
        <div class="modal-header">
            <div>
                <h2 class="modal-title">Просмотр события</h2>
            </div>
        </div>
        <div class="modal-body logs-modal__body">
            <div class="logs-modal__fields">
                <div class="form-group logs-modal__field">
                    <label>Дата</label>
                    <div class="logs-modal__value-field" data-role="log-date">—</div>
                </div>
                <div class="form-group logs-modal__field">
                    <label>Пользователь</label>
                    <div class="logs-modal__value-field" data-role="log-user">—</div>
                </div>
                <div class="form-group logs-modal__field">
                    <label>Событие</label>
                    <div class="logs-modal__value-field" data-role="log-event">—</div>
                </div>
                <div class="form-group logs-modal__field">
                    <label>Название таблицы</label>
                    <div class="logs-modal__value-field" data-role="log-table-name">—</div>
                </div>
            </div>

            <div class="logs-modal__section">
                <div class="logs-modal__record-table-wrap" data-role="log-record-table"></div>
            </div>
        </div>
    </div>
</div>
