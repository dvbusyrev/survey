@model MainProject.Web.ViewModels.AuditLogPageViewModel

@{
    ViewData["Title"] = "Журнал событий";
    var pageModel = Model ?? new MainProject.Web.ViewModels.AuditLogPageViewModel();
    var logs = pageModel.Logs ?? Array.Empty<MainProject.Domain.Entities.Log>();
    var paginationModel = pageModel.Pagination;
    var loadErrorMessage = ViewData["LogLoadErrorMessage"] as string;
    var logBootstrapItems = logs.Select(log => new
    {
        id = log.IdLog,
        date = log.Date.ToString("dd.MM.yyyy HH:mm:ss"),
        user = string.IsNullOrWhiteSpace(log.NameUser) ? "Система" : log.NameUser,
        eventType = string.IsNullOrWhiteSpace(log.EventType) ? "—" : log.EventType,
        targetType = log.TargetType ?? string.Empty,
        targetName = log.TargetName ?? string.Empty,
        description = log.Description ?? string.Empty,
        extraDataJson = string.Empty
    });
    var logsBootstrapJson = System.Text.Json.JsonSerializer.Serialize(logBootstrapItems);
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/logs.css" asp-append-version="true" />
}

<div class="app-page logs-page" id="default_content" data-page="get_logs">
    @await Html.PartialAsync(
        "~/Web/Views/Shared/_PageIntro.cshtml",
        new MainProject.Web.ViewModels.PageIntroModel
        {
            Title = "Журнал событий",
            Description = "Ниже представлен журнал действий пользователей и системных операций."
        })

    <div class="app-page__toolbar survey-list-toolbar">
        <a class="btn modal_btn modal_btn-primary" href="/event-log/export">Выгрузить журнал событий</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(loadErrorMessage))
    {
        <div class="app-page__section">
            <p>@loadErrorMessage</p>
        </div>
    }

    <table id="logs-table-top" class="surveys-table logs-table" data-role="main-table" data-disable-column-sort="true" data-disable-table-pagination="true">
        <thead>
            <tr class="table_tr">
                <th class="table-th--start table-col--date table-sortable @(pageModel.IsSortedBy(AuditLogSortFields.Date) ? "is-sorted" : string.Empty)"
                    data-sort-direction="@pageModel.GetHeaderSortDirection(AuditLogSortFields.Date)"
                    aria-sort="@pageModel.GetAriaSort(AuditLogSortFields.Date)">
                    <a class="logs-table__sort-link" href="@pageModel.BuildSortUrl(AuditLogSortFields.Date)">Дата</a>
                </th>
                <th class="table-col--user table-sortable @(pageModel.IsSortedBy(AuditLogSortFields.User) ? "is-sorted" : string.Empty)"
                    data-sort-direction="@pageModel.GetHeaderSortDirection(AuditLogSortFields.User)"
                    aria-sort="@pageModel.GetAriaSort(AuditLogSortFields.User)">
                    <a class="logs-table__sort-link" href="@pageModel.BuildSortUrl(AuditLogSortFields.User)">Пользователь</a>
                </th>
                <th class="table-col--event table-sortable @(pageModel.IsSortedBy(AuditLogSortFields.Event) ? "is-sorted" : string.Empty)"
                    data-sort-direction="@pageModel.GetHeaderSortDirection(AuditLogSortFields.Event)"
                    aria-sort="@pageModel.GetAriaSort(AuditLogSortFields.Event)">
                    <a class="logs-table__sort-link" href="@pageModel.BuildSortUrl(AuditLogSortFields.Event)">Событие</a>
                </th>
                <th class="table-th--end table-col--description table-sortable @(pageModel.IsSortedBy(AuditLogSortFields.Description) ? "is-sorted" : string.Empty)"
                    data-sort-direction="@pageModel.GetHeaderSortDirection(AuditLogSortFields.Description)"
                    aria-sort="@pageModel.GetAriaSort(AuditLogSortFields.Description)">
                    <a class="logs-table__sort-link" href="@pageModel.BuildSortUrl(AuditLogSortFields.Description)">
                        <span class="logs-table__sort-label">Описание</span>
                    </a>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (!logs.Any())
            {
                <tr>
                    <td colspan="4" class="table-empty-cell">События не найдены</td>
                </tr>
            }
            else
            {
                foreach (var log in logs)
                {
                    <tr data-log-id="@log.IdLog" tabindex="0" title="Двойной клик для просмотра события">
                        <td class="table-col--date">@log.Date.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td class="table-col--user">@(string.IsNullOrWhiteSpace(log.NameUser) ? "Система" : log.NameUser)</td>
                        <td class="table-col--event">@(string.IsNullOrWhiteSpace(log.EventType) ? "—" : log.EventType)</td>
                        <td class="table-col--description logs-table__summary">@(string.IsNullOrWhiteSpace(log.Description) ? "—" : log.Description)</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @await Html.PartialAsync("~/Web/Views/Shared/_AppPagination.cshtml", paginationModel)

    <script type="application/json" id="logs-page-bootstrap">
        @Html.Raw(logsBootstrapJson)
    </script>

    @await Html.PartialAsync("~/Web/Views/Shared/_LogEntryModal.cshtml")
</div>

@section Scripts {
    <script src="~/js/features/admin/admin-logs-page.js" asp-append-version="true"></script>
}
