@model MainProject.Web.ViewModels.CheckAnswersPageViewModel

@{
    ViewData["Title"] = "Проверка ответов";
    var survey = Model.Survey;
    var answers = Model.Answers;
    var idOrganization = Model.IdOrganization;
    var isSigned = !string.IsNullOrWhiteSpace(survey?.Csp);
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/answers.css" asp-append-version="true" />
}

<div class="app-page app-page--narrow answers-page__check" id="default_content" data-page="answers-check" data-is-signed="@(isSigned ? "true" : "false")">
    @await Html.PartialAsync(
        "~/Web/Views/Shared/_PageIntro.cshtml",
        new MainProject.Web.ViewModels.PageIntroModel
        {
            Title = "Проверка ответов",
            Description = "На этой странице вы можете ознакомиться с сохранёнными ответами и выгрузить итоговые документы."
        })
    @if (string.IsNullOrWhiteSpace(survey?.NameSurvey))
    {
        <section class="app-section app-page__section">
            <div class="answers-page__error">
                <h2>Ошибка</h2>
                <p>Информация об анкете не найдена</p>
            </div>
        </section>
    }
    else
    {
        <section class="app-section app-page__section app-page__stack">
            <h3>@survey.NameSurvey</h3>

            @if (!string.IsNullOrEmpty(survey.Description))
            {
                <p>@survey.Description</p>
            }
        </section>

        <div class="table-container">
            @if (answers == null || !answers.Any())
            {
                <p>Ответы не найдены</p>
            }
            else
            {
                <table data-column-sort="true" data-role="main-table">
                    <thead>
                        <tr>
                            <th>Вопрос</th>
                            <th>Оценка</th>
                            <th>Комментарий</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var answer in answers)
                        {
                            <tr>
                                <td>@answer.DisplayQuestion</td>
                                <td>@answer.DisplayRating</td>
                                <td>@answer.Comment</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <section class="app-section app-page__section">
            <div class="answers-page__actions">
                <button type="button" class="app-button app-button--primary answers-page__action-button"
                        data-role="sign-actions"
                        data-role-sign-button="true"
                        data-click-call="CSP"
                        data-click-args='[@survey.IdSurvey, @idOrganization]'
                        disabled="@(isSigned ? "disabled" : null)">
                    @(isSigned ? "Подписано" : "Подписать")
                </button>
                <button type="button" class="app-button app-button--primary answers-page__action-button"
                        data-role="download-btn"
                        data-click-call="downloadAnswerDocument"
                        data-click-args='[@survey.IdSurvey, @idOrganization]'
                        data-click-pass-element="true">Скачать файл с анкетой</button>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script type="module" src="~/js/entries/check-answers-app.js" asp-append-version="true"></script>
}
