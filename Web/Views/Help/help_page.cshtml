@{
    ViewData["Title"] = "Инструкции";
    ViewData["UtilitySection"] = "help";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/admin-utility-pages.css" asp-append-version="true" />
}

<div class="app-page help-page" id="default_content" data-page="help-page">
    @await Html.PartialAsync("~/Web/Views/Shared/_UtilitySubnav.cshtml")
    @await Html.PartialAsync(
        "~/Web/Views/Shared/_PageIntro.cshtml",
        new MainProject.Web.ViewModels.PageIntroModel
        {
            Description = "Здесь можно скачать текущую инструкцию и загрузить новую версию для администраторов или клиентов."
        })

    <div class="app-page__toolbar survey-list-toolbar help-page__actions">
        <select class="form-control help-page__select"
                data-change-call="handleSelectChange"
                data-change-pass-element="true">
            <option value="" disabled selected>Загрузить новую инструкцию</option>
            <option value="admin">Для администратора</option>
            <option value="user">Для клиента</option>
        </select>
    </div>

    <section class="app-page__section">
        <p class="help-page__message">Файл DOCX с инструкцией успешно скачан. Пожалуйста, проверьте загрузки.</p>
    </section>
</div>

@section Scripts {
    <script src="~/js/features/help/help-page.js" asp-append-version="true"></script>
}
