@model MainProject.Domain.Entities.Organization
@{
    ViewData["Title"] = "Просмотр организации";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/organization.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="app-page app-page--narrow organization-form-page" id="default_content" data-page="organization-update">
    @await Html.PartialAsync(
        "~/Web/Views/Shared/_PageIntro.cshtml",
        new MainProject.Web.ViewModels.PageIntroModel
        {
            Title = "Просмотр организации",
            Description = "В форме ниже вы можете изменить данные организации"
        })
    <section class="app-page__section app-page__stack">
        <div class="form-group">
            <label for="name">Наименование</label>
            <input type="text" class="form-control" id="name" placeholder="Введите наименование" value="@Model?.OrganizationName" required />
        </div>
        <div class="form-group">
            <label for="short_name">Краткое название</label>
            <input type="text" class="form-control" id="short_name" placeholder="Введите краткое название" value="@Model?.OrganizationShortName" />
        </div>
        <div class="form-group">
            <label for="email">Эл. почта</label>
            <input type="text" class="form-control" id="email" placeholder="Введите эл. почту" value="@Model?.Email" />
        </div>

        <div class="form-group">
            <label for="date_begin">Дата начала</label>
            <input type="date" class="form-control" id="date_begin" name="date_begin" data-date-native="true" data-date-label="Дата начала" lang="ru-RU"
                   value="@(Model?.DateBegin?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="form-group">
            <label for="date_end">Дата конца</label>
            <input type="date" class="form-control" id="date_end" name="date_end" data-date-native="true" data-date-label="Дата конца" lang="ru-RU"
                   value="@(Model?.DateEnd?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="button-container organization-form__actions">
            <button type="button"
                    class="btn"
                    data-click-call="updateOrganizationPage"
                    data-click-args='[@(Model?.OrganizationId ?? 0)]'>Обновить организацию</button>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/features/organization/organization-page.js" asp-append-version="true"></script>
}
