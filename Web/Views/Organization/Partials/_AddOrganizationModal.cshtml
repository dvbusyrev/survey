<div id="addOrganizationModal" class="modal organization-modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="h2_modal">Добавление организации</h2>
            <button type="button" class="modal-close" data-modal-close="addOrganizationModal"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="modal-body">
            <form id="organizationForm">
                @Html.AntiForgeryToken()
                <section class="app-page__section app-page__stack">
                    <div id="message" class="organization-form__message"></div>

                    <div class="form-group">
                        <label for="Name">Название организации</label>
                        <input type="text" class="form-control" id="Name" required>
                    </div>

                    <div class="form-group">
                        <label for="ShortName">Краткое название</label>
                        <input type="text" class="form-control" id="ShortName">
                    </div>

                    <div class="form-group">
                        <label for="organization_email">Эл. почта</label>
                        <div class="input-container">
                            <div class="icon-container field-icon-container"><i class="fas fa-envelope"></i></div>
                            <input type="email" class="form-control" id="organization_email" placeholder="Введите эл. почту">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="DateBegin">Дата начала</label>
                        <input type="date" class="form-control" id="DateBegin" data-date-native="true" data-date-label="Дата начала" lang="ru-RU">
                    </div>

                    <div class="form-group">
                        <label for="DateEnd">Дата конца</label>
                        <input type="date" class="form-control" id="DateEnd" data-date-native="true" data-date-label="Дата конца" lang="ru-RU">
                    </div>
                </section>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="modal_btn modal_btn-secondary" data-modal-close="addOrganizationModal">Отмена</button>
            <button type="button" class="modal_btn modal_btn-primary" data-click-call="createOrganization">Сохранить</button>
        </div>
    </div>
</div>
