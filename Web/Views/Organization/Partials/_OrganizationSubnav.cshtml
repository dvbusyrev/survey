@{
    var activeSection = (ViewData["OrganizationSection"] as string ?? "list").ToLowerInvariant();
    var listActive = activeSection == "list";
    var surveysActive = activeSection == "surveys";
    var archiveActive = activeSection == "archive";
}

<div class="menu-bar app-page__subnav" role="tablist" aria-label="Разделы организаций">
    <a
        href="/organizations"
        class="menu-tab @(listActive ? "active-tab" : "")"
        role="tab"
        aria-selected="@(listActive ? "true" : "false")"
        data-tab-target="get_organization">
        Список организаций
    </a>
    <a
        href="/organizations/survey"
        class="menu-tab @(surveysActive ? "active-tab" : "")"
        role="tab"
        aria-selected="@(surveysActive ? "true" : "false")"
        data-tab-target="organization_surveys">
        Продление анкет
    </a>
    <a
        href="/organizations/archive"
        class="menu-tab @(archiveActive ? "active-tab" : "")"
        role="tab"
        aria-selected="@(archiveActive ? "true" : "false")"
        data-tab-target="archive_list_organizations">
        Архивные организации
    </a>
</div>
