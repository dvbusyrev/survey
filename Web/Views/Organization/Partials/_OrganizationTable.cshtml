@model MainProject.Web.ViewModels.OrganizationTableViewModel

@{
    var organizations = Model?.Organizations ?? Array.Empty<MainProject.Domain.Entities.Organization>();
    var showActions = Model?.ShowActions ?? false;
}

<table id="@Model?.TableId"
       class="organization-table"
       data-role="main-table"
       data-disable-column-sort="true">
    <thead>
        <tr class='table_tr'>
            <th class="table-th--start table-sortable @(string.IsNullOrWhiteSpace(Model?.NameSortDirection) ? string.Empty : "is-sorted")"
                data-sort-direction="@Model?.NameSortDirection"
                aria-sort="@Model?.NameAriaSort">
                <a class="logs-table__sort-link" href="@Model?.NameSortUrl">Организация</a>
            </th>
            <th class="table-col--date table-sortable @(string.IsNullOrWhiteSpace(Model?.DateBeginSortDirection) ? string.Empty : "is-sorted")"
                data-sort-direction="@Model?.DateBeginSortDirection"
                aria-sort="@Model?.DateBeginAriaSort">
                <a class="logs-table__sort-link" href="@Model?.DateBeginSortUrl">Дата начала</a>
            </th>
            <th class="table-col--date table-sortable @(string.IsNullOrWhiteSpace(Model?.DateEndSortDirection) ? string.Empty : "is-sorted")"
                data-sort-direction="@Model?.DateEndSortDirection"
                aria-sort="@Model?.DateEndAriaSort">
                <a class="logs-table__sort-link" href="@Model?.DateEndSortUrl">Дата конца</a>
            </th>
            <th class="table-th--end table-col--actions">Действия</th>
        </tr>
    </thead>
    <tbody id="organizationTableBody">
        @if (!organizations.Any())
        {
            <tr>
                <td colspan="4" class="table-empty-cell">Результаты не найдены!</td>
            </tr>
        }
        else
        {
            foreach (var organization in organizations)
            {
                <tr
                    @if (showActions)
                    {
                        <text>
                        data-dblclick-call="openEditOrganizationModalFromTrigger"
                        data-dblclick-pass-element="true"
                        data-organization-id="@organization.OrganizationId"
                        data-organization-name="@(organization.OrganizationName ?? string.Empty)"
                        data-organization-short-name="@(organization.OrganizationShortName ?? string.Empty)"
                        data-organization-email="@(organization.Email ?? string.Empty)"
                        data-organization-date-begin="@(organization.DateBegin?.ToString("yyyy-MM-dd") ?? string.Empty)"
                        data-organization-date-end="@(organization.DateEnd?.ToString("yyyy-MM-dd") ?? string.Empty)"
                        </text>
                    }>
                    <td>@organization.OrganizationName</td>
                    <td class="table-col--date">@(organization.DateBegin?.ToString("dd.MM.yyyy") ?? "")</td>
                    <td class="table-col--date">@(organization.DateEnd?.ToString("dd.MM.yyyy") ?? "")</td>
                    <td class="action-icons table-col--actions">
                        @if (showActions)
                        {
                            <div class="action-icons__content">
                                <div class="icon-container"
                                     data-organization-id="@organization.OrganizationId"
                                     data-organization-name="@(organization.OrganizationName ?? string.Empty)"
                                     data-organization-short-name="@(organization.OrganizationShortName ?? string.Empty)"
                                     data-organization-email="@(organization.Email ?? string.Empty)"
                                     data-organization-date-begin="@(organization.DateBegin?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                     data-organization-date-end="@(organization.DateEnd?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                     data-click-call="openEditOrganizationModalFromTrigger"
                                     data-click-pass-element="true">
                                    <span><i class="fas fa-pen-to-square"></i></span>
                                    <span class="icon-tooltip">Посмотреть / обновить</span>
                                </div>
                                <div class="icon-container"
                                     data-click-call="deleteOrganization"
                                     data-click-args='[@organization.OrganizationId]'>
                                    <span><i class="fas fa-trash"></i></span>
                                    <span class="icon-tooltip">Удалить</span>
                                </div>
                            </div>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
