<div id="editOrganizationModal" class="modal organization-modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="h2_modal">Просмотр организации</h2>
            <button type="button" class="modal-close" data-modal-close="editOrganizationModal"><i class="fas fa-xmark"></i></button>
        </div>
        <div class="modal-body">
            <section class="app-page__section app-page__stack">
                <input type="hidden" id="editOrganizationId">
                <div class="form-group">
                    <label>Название организации</label>
                    <input type="text" id="organizationName" class="form-control">
                </div>
                <div class="form-group">
                    <label>Краткое название</label>
                    <input type="text" id="organizationShortName" class="form-control">
                </div>
                <div class="form-group">
                    <label for="organizationEmail">Эл. почта</label>
                    <div class="input-container">
                        <div class="icon-container field-icon-container"><i class="fas fa-envelope"></i></div>
                        <input type="email" id="organizationEmail" class="form-control" placeholder="Введите эл. почту">
                    </div>
                </div>
                <div class="form-group">
                    <label>Дата начала</label>
                    <input type="date" id="organizationDateBegin" class="form-control" data-date-native="true" data-date-label="Дата начала" lang="ru-RU">
                </div>
                <div class="form-group">
                    <label>Дата конца</label>
                    <input type="date" id="organizationDateEnd" class="form-control" data-date-native="true" data-date-label="Дата конца" lang="ru-RU">
                </div>
            </section>
        </div>
        <div class="modal-footer">
            <button type="button" data-modal-close="editOrganizationModal" class="modal_btn modal_btn-secondary">Отмена</button>
            <button type="button" id="saveOrganizationBtn" data-click-call="updateOrganization" class="modal_btn modal_btn-primary">Сохранить</button>
        </div>
    </div>
</div>
