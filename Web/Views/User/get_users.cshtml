@model MainProject.Web.ViewModels.UserListPageViewModel

@{
    ViewData["Title"] = "Список пользователей";
    ViewData["UserSection"] = "list";
    var users = Model?.Users ?? Array.Empty<MainProject.Domain.Entities.User>();
    var organizations = Model?.Organizations ?? Array.Empty<MainProject.Application.DTO.SelectionOption>();
    var openAddUserModal = Model?.OpenAddUserModal ?? false;
}

<div class="app-page users-page" id="default_content" data-page="users-list">
    @await Html.PartialAsync("~/Web/Views/User/Partials/_UserSubnav.cshtml")
    @await Html.PartialAsync(
        "~/Web/Views/Shared/_PageIntro.cshtml",
        new MainProject.Web.ViewModels.PageIntroModel
        {
            // Title = "Список пользователей",
            Description = "Ниже представлена таблица с существующими пользователями."
        })

    <div class="users-page-toolbar app-page__toolbar">
        <button type="button" class="modal_btn modal_btn-primary" data-click-call="openAddUserModal">Добавить пользователя</button>
    </div>

    <section class="app-page__section app-page__section--flush">
        @await Html.PartialAsync(
            "~/Web/Views/User/Partials/_UserTable.cshtml",
            new MainProject.Web.ViewModels.UserTableViewModel
            {
                Users = users,
                ShowActions = true
            })
    </section>
</div>

@await Html.PartialAsync("~/Web/Views/User/Partials/_UserManagementModals.cshtml", organizations)


@section Scripts {
    @await Html.PartialAsync("~/Web/Views/Shared/_AdminPageScripts.cshtml")
    <script>
    (function(){
        if (@(openAddUserModal.ToString().ToLower())) {
            if (window.location.pathname.toLowerCase() === '/users/create') {
                const nextState = window.history.state && typeof window.history.state === 'object'
                    ? { ...window.history.state, tab: 'get_users', id: null }
                    : { tab: 'get_users', id: null };
                window.history.replaceState(nextState, document.title, '/users');
            }

            setTimeout(function(){
                if (typeof window.openAddUserModal === 'function') {
                    window.openAddUserModal();
                } else {
                    var modal = document.getElementById('addUserModal');
                    if (modal) {
                        if (window.showSiteModal) {
                            window.showSiteModal(modal);
                        } else {
                            modal.style.display = 'flex';
                        }
                    }
                }
            }, 0);
        }
    })();
    </script>
}
